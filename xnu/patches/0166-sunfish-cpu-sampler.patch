diff --git a/bsd/dev/sweet_cpusample.c b/bsd/dev/sweet_cpusample.c
new file mode 100644
index 0000000..75bd02e
--- /dev/null
+++ b/bsd/dev/sweet_cpusample.c
@@ -0,0 +1,165 @@
+/*
+ * 0166: CPU use per thread and core type, without stopping anything.
+ *
+ * Boot-arg sweetcpusample=1 starts a 1 kHz timer_call that looks at the thread
+ * running on each CPU (racy, lock-free) and counts, per (pid, tid), samples on
+ * the A55 cores (cpu0-5) and the A76 cores (cpu6-7), plus busy/idle per CPU.
+ * Logical CPU numbers follow ascending MPIDR (SweetCPU.cpp), so cpu6/7 are the A76s.
+ * A kernel thread logs every 5 s for backboardd and SpringBoard:
+ *   SWEET CPU: 5s: <proc> tid <n> <name>: <ms> ms (A55 <ms>, A76 <ms>)   (top 4)
+ *   SWEET CPU: 5s: busy% c0 .. c7
+ * and swaps two tables, so the timer never meets a lock; no allocation in the timer.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/timer_call.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern void thread_deallocate(thread_t);
+extern thread_t sweet_cpu_active_thread(int cpu, int *idle);   /* osfmk/kern/thread.c */
+extern int hz;
+void sweet_cpusample_init(void);
+
+#define CS_CPUS     8
+#define CS_FIRST_A76 6
+#define CS_N        64
+#define CS_TICK_US  1000u
+
+struct cs_ent { int pid; uint64_t tid; uint32_t a55, a76; };
+struct cs_tab {
+	struct cs_ent e[CS_N];
+	uint32_t busy[CS_CPUS], total[CS_CPUS];
+};
+static struct cs_tab cs_tabs[2];
+static volatile uint32_t cs_cur;
+static timer_call_t cs_timer;
+
+static void
+cs_tick(__unused void *p0, __unused void *p1)
+{
+	struct cs_tab *t = &cs_tabs[cs_cur & 1];
+	int n = (int)MIN((uint32_t)ml_get_max_cpu_number() + 1, CS_CPUS);
+	for (int c = 0; c < n; c++) {
+		int idle = 0;
+		thread_t th = sweet_cpu_active_thread(c, &idle);
+		if (th == THREAD_NULL) {
+			continue;       /* not up yet */
+		}
+		t->total[c]++;
+		if (idle) {
+			continue;
+		}
+		t->busy[c]++;
+		task_t task = get_threadtask(th);
+		void *bp = task ? get_bsdtask_info(task) : NULL;
+		int pid = bp ? proc_pid((proc_t)bp) : 0;
+		if (pid <= 0) {
+			continue;       /* kernel threads: busy only */
+		}
+		uint64_t tid = thread_tid(th);
+		struct cs_ent *e = NULL, *min = &t->e[0];
+		for (int i = 0; i < CS_N; i++) {
+			struct cs_ent *x = &t->e[i];
+			if (x->pid == pid && x->tid == tid) {
+				e = x;
+				break;
+			}
+			if (x->a55 + x->a76 < min->a55 + min->a76) {
+				min = x;
+			}
+		}
+		if (!e) {
+			e = min;        /* evict the smallest (an empty slot has 0) */
+			e->pid = pid;
+			e->tid = tid;
+			e->a55 = e->a76 = 0;
+		}
+		if (c >= CS_FIRST_A76) {
+			e->a76++;
+		} else {
+			e->a55++;
+		}
+	}
+	uint64_t dl;
+	clock_interval_to_deadline(CS_TICK_US, NSEC_PER_USEC, &dl);
+	timer_call_enter(cs_timer, dl, TIMER_CALL_SYS_CRITICAL);
+}
+
+static void
+cs_report(struct cs_tab *t)
+{
+	char name[32];
+	for (int w = 0; w < 2; w++) {
+		const char *want = w ? "SpringBoard" : "backboardd";
+		for (int k = 0; k < 4; k++) {
+			struct cs_ent *best = NULL;
+			for (int i = 0; i < CS_N; i++) {
+				struct cs_ent *x = &t->e[i];
+				if (x->a55 + x->a76 == 0) {
+					continue;
+				}
+				name[0] = 0;
+				proc_name(x->pid, name, sizeof(name));
+				if (strcmp(name, want) == 0 &&
+				    (!best || x->a55 + x->a76 > best->a55 + best->a76)) {
+					best = x;
+				}
+			}
+			if (!best) {
+				break;
+			}
+			uint32_t ms = (best->a55 + best->a76) * CS_TICK_US / 1000;
+			printf("SWEET CPU: 5s: %s tid %llu -: %u ms (A55 %u, A76 %u)\n", want, best->tid,
+			    ms, best->a55 * CS_TICK_US / 1000, best->a76 * CS_TICK_US / 1000);
+			best->a55 = best->a76 = 0;      /* taken; the table is reset below anyway */
+		}
+	}
+	char line[96];
+	size_t l = 0;
+	for (int c = 0; c < CS_CPUS; c++) {
+		l += snprintf(line + l, sizeof(line) - l, " %u", t->total[c] ? t->busy[c] * 100 / t->total[c] : 0);
+	}
+	printf("SWEET CPU: 5s: busy%%%s\n", line);
+}
+
+/*
+ * Driven by sweet_gpu.c's 5 s stats tick (a context known to log): the first call parses the boot-arg and
+ * starts the 1 kHz timer, each later call reports the table the timer filled and switches it to the other.
+ */
+void
+sweet_cpusample_tick5s(void)
+{
+	static int state;               /* 0 unparsed, 1 off, 2 running */
+	uint64_t dl;
+	if (state == 0) {
+		uint32_t v = 0;
+		PE_parse_boot_argn("sweetcpusample", &v, sizeof(v));
+		state = 1;
+		printf("SWEET CPU: sweetcpusample=%u, boot-args %lu bytes, tail \"%s\"\n", v, strlen(PE_boot_args()),
+		    PE_boot_args() + (strlen(PE_boot_args()) > 60 ? strlen(PE_boot_args()) - 60 : 0));
+		if (v && (cs_timer = timer_call_alloc(cs_tick, NULL)) != NULL) {
+			clock_interval_to_deadline(CS_TICK_US, NSEC_PER_USEC, &dl);
+			timer_call_enter(cs_timer, dl, TIMER_CALL_SYS_CRITICAL);
+			state = 2;
+			printf("SWEET CPU: sampler started\n");
+		}
+		return;
+	}
+	if (state != 2) {
+		return;
+	}
+	struct cs_tab *old = &cs_tabs[cs_cur & 1];
+	cs_cur++;                       /* the timer now fills the other table */
+	delay(2000);                    /* let a running tick finish */
+	cs_report(old);
+	bzero(old, sizeof(*old));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 7671169..ba2df53 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -45,6 +45,7 @@ extern int vprintf(const char *fmt, va_list ap);
 extern void sweet_smc(uint64_t x[8]);
 
 void sweet_gpu_init(void);
+extern void sweet_cpusample_tick5s(void);
 #define GPU_TRAIL_PA	0xE2000000ull	/* sunfish: low RAM outside XNU (a6_log mirror) */
 #define GPU_TRAIL_SIZE	0x10000u
 bool sweet_gpu_ready(void);
@@ -535,6 +536,7 @@ gpu_stats_locked(void)
 		a6_log("5s: %u submits (%u missed), GPU busy %llu ms (%llu%%), longest %llu us, mean %llu us;%s\n",
 		    gstat_n, gstat_missed, gstat_busy / 19200, gstat_busy * 100 / 19200 / (ns / 1000000),
 		    gstat_longest * 10 / 192, gstat_busy * 10 / 192 / gstat_n, who);
+		sweet_cpusample_tick5s();	/* 0166: sweetcpusample=1 */
 	}
 	gstat_n = gstat_missed = 0;
 	gstat_busy = gstat_longest = 0;
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index b082a10..4b3729b 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -1294,3 +1294,19 @@ sleep_token_buffer_init(void)
 	}
 }
 #endif
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0166 (bsd/dev/sweet_cpusample.c): the thread running on a CPU right now, read
+ * without locks (the caller must tolerate a stale pointer and must not
+ * dereference it beyond the accessors; thread structs are zone memory and
+ * never unmapped). *idle is set for a per-processor idle thread.
+ */
+thread_t
+sweet_cpu_active_thread(int cpu, int *idle)
+{
+	cpu_data_t *c = cpu_datap(cpu);
+	thread_t t = c ? c->cpu_active_thread : THREAD_NULL;
+	*idle = (t != THREAD_NULL) && ((t->options & TH_OPT_IDLE_THREAD) != 0);
+	return t;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
