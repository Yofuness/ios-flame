From 8f54e6fa4b09d4e29c0cd11ee1231a36dd9ad9f8 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Fri, 30 Oct 2026 15:06:04 -0400
Subject: [PATCH] 0246 sunfish: reboot/sync sync in a helper thread with a 3 s
 limit; reboot! resets without sync

---
 bsd/dev/sweet_usb.c | 56 +++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 51 insertions(+), 5 deletions(-)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index ef04b62..18db92b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1020,11 +1020,52 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
  * (to test the panic path); "reboot" resets
  * the phone with PSCI (the shim already set the PMIC reason to
  * bootloader, so it lands in fastboot). tools/flame-cmd.py sends them.
+ * 0246: "sync" and "reboot" sync in a helper thread and wait at most 3 s
+ * (a sync stuck in a kernel-wide hang no longer blocks this loop or the
+ * reset; a stuck helper is not started again); "reboot!" resets at once
+ * without any sync.
  */
 extern void sweet_poke_run(const char *text, unsigned len);
 struct sync_args;
 extern int sync(proc_t p, struct sync_args *uap, int32_t *retval);
 
+/* 0246: 0 idle, 1 running, 2 done */
+static volatile int ud_sync_state;
+
+static void
+ud_sync_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	int32_t rv = 0;
+	(void)sync(kernproc, NULL, &rv);
+	__atomic_store_n(&ud_sync_state, 2, __ATOMIC_RELEASE);
+	thread_terminate(current_thread());
+}
+
+/* 0246: returns true if the sync finished within 3 s */
+static bool
+ud_sync_bounded(void)
+{
+	if (__atomic_load_n(&ud_sync_state, __ATOMIC_ACQUIRE) != 1) {
+		thread_t t;
+		__atomic_store_n(&ud_sync_state, 1, __ATOMIC_RELEASE);
+		if (kernel_thread_start(ud_sync_thread, NULL, &t) != KERN_SUCCESS) {
+			__atomic_store_n(&ud_sync_state, 0, __ATOMIC_RELEASE);
+			return false;
+		}
+		thread_deallocate(t);
+	} else {
+		printf("SWEET CMD: previous sync still stuck, not starting another\n");
+	}
+	for (int i = 0; i < 300; i++) {
+		if (__atomic_load_n(&ud_sync_state, __ATOMIC_ACQUIRE) == 2) {
+			__atomic_store_n(&ud_sync_state, 0, __ATOMIC_RELEASE);
+			return true;
+		}
+		ud_sleep_ms(10);
+	}
+	return false;
+}
+
 /*
  * Synthetic touches through the touchscreen's own path (SweetHID), in panel
  * pixels (0..1079, 0..2279): "tap X Y", "swipe X1 Y1 X2 Y2 MS" (finger 9,
@@ -1105,11 +1146,14 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 		}
 		cmd[got] = 0;
 		printf("SWEET CMD: %u bytes: %.60s\n", (unsigned)got, cmd);
-		if (strncmp(cmd, "sync", 4) == 0 || strncmp(cmd, "reboot", 6) == 0) {
+		bool ud_now = strncmp(cmd, "reboot!", 7) == 0;   /* 0246: no sync */
+		if (strncmp(cmd, "sync", 4) == 0 || (strncmp(cmd, "reboot", 6) == 0 && !ud_now)) {
 			/* Flush dirty file data (e.g. sweet_files.c writes) before a reset. */
-			int32_t rv = 0;
-			(void)sync(kernproc, NULL, &rv);
-			printf("SWEET CMD: synced\n");
+			if (ud_sync_bounded()) {
+				printf("SWEET CMD: synced\n");
+			} else {
+				printf("SWEET CMD: sync timed out%s\n", cmd[0] == 'r' ? ", resetting anyway" : "");
+			}
 			if (cmd[0] == 's') {
 				continue;
 			}
@@ -1163,7 +1207,9 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 			panic("SWEET CMD: panic requested over USB");
 		}
 		if (strncmp(cmd, "reboot", 6) == 0) {
-			ud_sleep_ms(1000);      /* let HFS finish the journal writes */
+			if (!ud_now) {
+				ud_sleep_ms(1000);      /* let HFS finish the journal writes */
+			}
 			printf("SWEET CMD: rebooting (PSCI SYSTEM_RESET)\n");
 			ud_sleep_ms(500);       /* let the log go out */
 			register uint64_t x0 __asm__("x0") = 0x84000009ULL;
-- 
