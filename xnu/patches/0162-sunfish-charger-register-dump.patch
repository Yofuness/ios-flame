From 6b3118036010a88708d17dce26c9fddd0712dfc6 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Sat, 24 Oct 2026 10:06:37 -0400
Subject: [PATCH] 0162 sunfish: read-only dump of PM6150 charger registers

---
 iokit/Kernel/arm/SweetBattery.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index b46c78f..701029e 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -277,6 +277,32 @@ SweetBattery::poll(void)
 			fShown--;
 		}
 	}
+	/*
+	 * 0162: read-only dump of the PM6150 SMB5 charger blocks (SID 0), once at the third poll and then
+	 * every 20th poll, to find the input-current and fast-charge-current settings.
+	 * Blocks: CHGR 0x1000, DCDC 0x1100, BATIF 0x1200, USBIN 0x1300, TYPEC 0x1500, MISC 0x1600.
+	 */
+	if (fPolls == 2 || (fPolls > 2 && (fPolls % 20u) == 0)) {
+		static const unsigned bases[] = { 0x1000, 0x1100, 0x1200, 0x1300, 0x1500, 0x1600 };
+		for (unsigned b = 0; b < sizeof(bases) / sizeof(bases[0]); b++) {
+			for (unsigned row = 0; row < 0x80; row += 16) {
+				char line[16 * 3 + 1];
+				unsigned n = 0;
+				for (unsigned i = 0; i < 16; i++) {
+					uint8_t v = 0;
+					const char *hex = "0123456789abcdef";
+					if (sweet_spmi_read(0, bases[b] + row + i, &v)) {
+						line[n++] = '?'; line[n++] = '?';
+					} else {
+						line[n++] = hex[v >> 4]; line[n++] = hex[v & 15];
+					}
+					line[n++] = ' ';
+				}
+				line[n] = 0;
+				IOLog("SWEET CHARGER: %04x: %s\n", bases[b] + row, line);
+			}
+		}
+	}
 	if ((fPolls++ % 10u) == 0) {
 		IOLog("SWEET BATTERY: %umV %dmA ocv %u ema %u -> target %d%% shown %d%% ext=%d chg=%d\n",
 		    mv, ma, ocv, fEmaMv, target, fShown, external, charging);
-- 
