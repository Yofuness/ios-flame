From 112e975ea18ecb25809bfda0d0320f85824e6630 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Mon, 26 Oct 2026 21:01:07 -0400
Subject: [PATCH] sunfish: wait-forever hang injector, SMMU/GBIF reset before
 CP init, pre-me_init diagnostics

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_a6xx.c | 65 ++++++++++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_a6xx.h |  1 +
 bsd/dev/sweet_gpu.c  |  8 +++++-
 3 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index 8f2124a..104e24a 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -16,6 +16,7 @@
 
 int a6_submit_wfi;	/* 0157: CP_WAIT_FOR_IDLE after each client submit (boot-arg sweetwfi) */
 int a6_recover_mode = 1;	/* 0167: 2 = full recovery with a GX power cycle (boot-arg sweetgpurecover) */
+int a6_inject_stall_ib;	/* 0177: sweethangtest bit 30: the next submit gets a valid IB that waits forever */
 int a6_inject_bad_ib;	/* 0167: sweethangtest: the next submit gets an IB at an unmapped address */
 
 #define rd32		a6_rd
@@ -1033,6 +1034,28 @@ uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint3
 		dw[n++] = 0xff;
 		dw[n++] = 16;
 	}
+	if (a6_inject_stall_ib) {
+		/*
+		 * 0177: sweethangtest bit 30: a valid IB (scratch page, +0xe00) whose only packet is CP_WAIT_REG_MEM on a
+		 * zero dword (+0xf00, never written again) until it equals 1: the CP waits forever, no SMMU fault
+		 */
+		uint64_t ib = a6_pool_va(A6_OFF_SCRATCH + 0xe00), poll = a6_pool_va(A6_OFF_SCRATCH + 0xf00);
+		uint32_t ibd[7], zero = 0, k = 0;
+		a6_inject_stall_ib = 0;
+		ibd[k++] = a6_pkt7(0x3c, 6);	/* CP_WAIT_REG_MEM */
+		ibd[k++] = 3 | (1u << 4);	/* function EQUAL, poll memory */
+		ibd[k++] = (uint32_t)poll;
+		ibd[k++] = (uint32_t)(poll >> 32);
+		ibd[k++] = 1;			/* ref */
+		ibd[k++] = 0xffffffff;		/* mask */
+		ibd[k++] = 16;			/* poll interval */
+		a6_write(a6_pool_pa(g, A6_OFF_SCRATCH + 0xf00), &zero, 4);
+		a6_write(a6_pool_pa(g, A6_OFF_SCRATCH + 0xe00), ibd, sizeof(ibd));
+		dw[n++] = a6_pkt7(A6_CP_INDIRECT_BUFFER, 3);
+		dw[n++] = (uint32_t)ib;
+		dw[n++] = (uint32_t)(ib >> 32);
+		dw[n++] = 7;
+	}
 	/* 0157: no wait-for-idle between client submits (sweetwfi=1 brings it back): CACHE_FLUSH_TS below
 	 * lands only once the work before it is done, and the CP may start the next submit meanwhile */
 	if (a6_submit_wfi)
@@ -1368,6 +1391,34 @@ static int zap_resume(void)
 
 static int gpu_cp_init(struct a6_gpu *g, bool resume);
 
+/*
+ * 0177: a real hang (no SMMU fault, CP stuck mid-IB) left me_init timing out after GX off/on (rptr 0): reset the GPU
+ * context bank (SCTLR.M off, FSR cleared, TLBIALL + sync, SCTLR back) and release both GBIF halts right before
+ * the CP init. Also arms the pre-me_init register dump in gpu_cp_init.
+ */
+static bool recover_diag;
+
+static void a6_smmu_gbif_reset(const struct a6_gpu *g)
+{
+	recover_diag = true;
+	if (g->gpu_cb < 0)
+		return;
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	uint32_t sctlr = rd32(c + CB_SCTLR);
+	wr32(c + CB_SCTLR, sctlr & ~1u);
+	(void)rd32(c + CB_SCTLR);
+	wr32(c + CB_FSR, 0xffffffff);
+	wr32(c + CB_TLBIALL, 0);
+	wr32(c + CB_TLBSYNC, 0);
+	(void)wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
+	wr32(c + CB_SCTLR, sctlr);
+	(void)rd32(c + CB_SCTLR);
+	wr32(GREG(0x3c45), 0);			/* GBIF_HALT */
+	wr32(GREG(0x16), 0);			/* RBBM_GBIF_HALT */
+	a6_log("recover2: smmu/gbif reset: sctlr %x fsr %x tlbstatus %x\n", rd32(c + CB_SCTLR), rd32(c + CB_FSR),
+	    rd32(c + CB_TLBSTATUS));
+}
+
 static int gpu_cp(struct a6_gpu *g)
 {
 	if (smmu_pick(&g->gpu_smr, &g->gpu_cb, g->gmu_cb + 1)) {
@@ -1422,6 +1473,7 @@ static int a6_recover_full(struct a6_gpu *g)
 	if (rc == 0) {
 		(void)a6_clear_fault(g);
 		a6_tlb_flush(g);
+		a6_smmu_gbif_reset(g);
 		recover2_active = true;
 		rc = gpu_cp_init(g, false);
 		recover2_active = false;
@@ -1451,6 +1503,7 @@ int a6_recover(struct a6_gpu *g)
 	wr32(GREG(0x43), 0);
 	a6_delay_ms(1);
 	(void)a6_clear_fault(g);
+	a6_smmu_gbif_reset(g);
 	int rc = gpu_cp_init(g, true);
 	a6_log("recover: soft reset + CP init -> %d\n", rc);
 	if (rc == 0)
@@ -1470,6 +1523,7 @@ int a6_recover(struct a6_gpu *g)
 	wr32(GREG(0x43), 0);
 	a6_delay_ms(10);
 	(void)a6_clear_fault(g);
+	a6_smmu_gbif_reset(g);
 	rc = gpu_cp_init(g, true);
 	a6_log("recover: GBIF halt + soft reset + CP init -> %d\n", rc);
 	return rc;
@@ -1544,6 +1598,17 @@ static int gpu_cp_init(struct a6_gpu *g, bool resume)
 	g->wptr = 0;
 	wr32(GREG(CP_SQE_CNTL), 1);
 
+	if (recover_diag) {
+		/* 0177: state right before the first me_init of a recovery */
+		uint64_t c = SMMU_CB(g->gpu_cb);
+		recover_diag = false;
+		a6_log("recover2: pre-me_init: cb sctlr %x fsr %x tlbstatus %x, gbif halt %x ack %x, rbbm halt ack %x, "
+		    "rb base %x/%x, sqe base %x/%x, gpucc +1534 %x +1554 %x\n",
+		    rd32(c + CB_SCTLR), rd32(c + CB_FSR), rd32(c + CB_TLBSTATUS), rd32(GREG(0x3c45)), rd32(GREG(0x3c46)),
+		    rd32(GREG(0x17)), rd32(GREG(CP_RB_BASE + 1)), rd32(GREG(CP_RB_BASE)),
+		    rd32(GREG(CP_SQE_INSTR_BASE + 1)), rd32(GREG(CP_SQE_INSTR_BASE)),
+		    rd32(GPUCC + 0x1534), rd32(GPUCC + 0x1554));
+	}
 	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
 	if (a6_ring(g, me_init, 9, "me_init", 1000))
 		return -1;
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
index 3dea741..b85d8cc 100644
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -83,6 +83,7 @@ static inline uint64_t a6_pool_va(uint64_t off) { return A6_GVA_POOL + off; }
 void a6_init_state(struct a6_gpu *g, uint64_t pool_pa);
 int a6_power_up(struct a6_gpu *g);	/* everything up to a working CP with the zap shader; 0 = ok */
 extern int a6_recover_mode;	/* 0167: 2 = GX power cycle in a6_recover */
+extern int a6_inject_stall_ib;	/* 0177: sweethangtest bit 30: the next async submit carries a wait-forever IB */
 extern int a6_inject_bad_ib;	/* 0167: sweethangtest: the next async submit carries a bad IB */
 int a6_recover(struct a6_gpu *g);	/* after a hang/fault: soft reset, CP re-init (mappings kept); 0 = ok */
 bool a6_cx_up(void);
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 8ae6991..2b03f13 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -630,8 +630,14 @@ gpu_hangtest_arm(bool is_present)
 	if (hangtest_done || hangtest_arg == 0 || !!(hangtest_arg & 0x80000000u) != is_present) {
 		return;
 	}
-	if (++hangtest_count == (hangtest_arg & 0x7fffffffu)) {
+	if (++hangtest_count == (hangtest_arg & 0x3fffffffu)) {
 		hangtest_done = true;
+		if (hangtest_arg & 0x40000000u) {
+			/* 0177: bit 30: a valid IB that waits forever (no SMMU fault) */
+			a6_inject_stall_ib = 1;
+			a6_log("hangtest: injecting stall IB at %s submit %u\n", is_present ? "present" : "client", hangtest_count);
+			return;
+		}
 		a6_inject_bad_ib = 1;
 		a6_log("hangtest: injecting bad IB at %s submit %u\n", is_present ? "present" : "client", hangtest_count);
 	}
-- 
2.56.0

