From a2c3dd48ec589f0b6dcbd4a0e4545d88d72c92a0 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Tue, 27 Oct 2026 07:49:45 -0400
Subject: [PATCH] sunfish: SMMU stall-on-fault mode by default (sweetsmmustall)

---
 bsd/dev/sweet_a6xx.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index f71ab79..c949b07 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -264,6 +264,21 @@ static void map_gmu_pages(uint64_t l3, uint32_t va, uint64_t pa, uint32_t size,
 	}
 }
 
+/*
+ * 0182: boot-arg sweetsmmustall (default 1): the GPU context bank stalls on a fault (SCTLR CFCFG) instead of
+ * terminating it, so a real fault hangs the GPU and goes through the recovery 0181 proved (CB_RESUME first).
+ */
+static uint32_t smmu_stall_bit(void)
+{
+	static int v = -1;
+	if (v < 0) {
+		v = 1;
+		(void)PE_parse_boot_argn("sweetsmmustall", &v, sizeof(v));
+		v = v != 0;
+	}
+	return v ? 0x80u : 0;
+}
+
 /* T0SZ: 32 (4 GB) for the GMU, 25 (39-bit) for the GPU; walks start at level 1 either way. */
 static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
 {
@@ -277,7 +292,7 @@ static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t ma
 	wr32(c + CB_TCR, t0sz | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
 	wr32(c + CB_MAIR0, 0x0000ff44);
 	wr32(c + CB_FSR, 0xffffffff);
-	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40);		/* M TRE AFE CFRE CFIE */
+	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40 | (sid == GPU_SID ? smmu_stall_bit() : 0));	/* M TRE AFE CFRE CFIE (+CFCFG, 0182) */
 	wr32(SMMU + 0x68, 0);					/* TLBIALLNSNH */
 	wr32(SMMU + 0x70, 0);					/* TLBGSYNC */
 	wait_bit(SMMU + 0x74, 1, 0, 10);
@@ -371,6 +386,8 @@ int a6_clear_fault(const struct a6_gpu *g)
 		return 0;
 	a6_log("clearing smmu cb%d fault: fsr %x far %llx fsynr0 %x\n", g->gpu_cb, fsr,
 	       (unsigned long long)far, syn);
+	if (rd32(SMMU_CB(g->gpu_cb) + CB_FSR) & (1u << 30))
+		wr32(SMMU_CB(g->gpu_cb) + CB_RESUME, 1);	/* 0182: stalled (SS): terminate it */
 	wr32(SMMU_CB(g->gpu_cb) + CB_FSR, rd32(SMMU_CB(g->gpu_cb) + CB_FSR));
 	return 1;
 }
@@ -1455,7 +1472,7 @@ static void a6_smmu_gbif_reset(const struct a6_gpu *g)
 	wr32(c + CB_TLBIALL, 0);
 	wr32(c + CB_TLBSYNC, 0);
 	(void)wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
-	wr32(c + CB_SCTLR, sctlr);
+	wr32(c + CB_SCTLR, sctlr | smmu_stall_bit());	/* 0182: stall mode back on */
 	(void)rd32(c + CB_SCTLR);
 	wr32(GREG(0x3c45), 0);			/* GBIF_HALT */
 	wr32(GREG(0x16), 0);			/* RBBM_GBIF_HALT */
-- 
