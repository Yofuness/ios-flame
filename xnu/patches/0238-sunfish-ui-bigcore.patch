diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index a06a80c..b87e4f8 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -5021,6 +5021,75 @@ choose_next_pset(
  *	The thread must be locked.  The pset must be locked,
  *	and the resulting pset is locked on return.
  */
+/*
+ * sunfish 0238 (from ios-redfin 1041, MIT): kern.sweet_ui_bigcore MASK (sysctl in bsd/dev/sweet_cpufreq.c), default 1,
+ * boot-arg sweetuibig=0 off. Threads are tagged when named (bsd_setthreadname): com.apple.coreanimation.display*
+ * (class 1, backboardd's CA display thread) and com.apple.coreanimation.render-server* (class 2). For a tagged thread
+ * whose class bit is set, choose_processor() takes an idle big core (CPU7, CPU6: the A76 pair, SWEET_UI_BIG_MASK
+ * 0xc0), else preempts the big core running the lowest priority below the thread's, else the normal choice.
+ */
+#define SWEET_UI_BIG_MASK       0xc0u           /* CPUs 6-7 = A76 (sunfish 6 x A55 + 2 x A76, as 0147) */
+int sweet_ui_bigcore = -1;              /* -1 = boot-arg not parsed yet; choose_processor treats it as 0 */
+static uint32_t sweet_ui_tagged;
+/* 0238 v2: lock-free stats for choose_processor (no printf under the pset lock: kernel114 reset), kern.sweet_ui_* */
+uint32_t sweet_ui_idle_n, sweet_ui_preempt_n, sweet_ui_first_set;
+uint64_t sweet_ui_first_tid;
+int sweet_ui_first_cpu, sweet_ui_first_preempt;
+
+/* thread context only (sysctl, bsd_setthreadname): parses sweetuibig once; never called from choose_processor */
+int sweet_ui_mode(void);
+int
+sweet_ui_mode(void)
+{
+	if (__improbable(sweet_ui_bigcore < 0)) {
+		int v = 1;
+		PE_parse_boot_argn("sweetuibig", &v, sizeof(v));
+		sweet_ui_bigcore = v;
+	}
+	return sweet_ui_bigcore;
+}
+
+void sweet_ui_thread_named(void *uth, const char *name);
+void
+sweet_ui_thread_named(void *uth, const char *name)
+{
+	thread_t th = get_machthread((struct uthread *)uth);
+	uint32_t f = 0;
+	if (name == NULL || th == THREAD_NULL) {
+		return;
+	}
+	(void)sweet_ui_mode();  /* 0238 v2: parse the boot-arg here, before any thread is tagged */
+	if (strncmp(name, "com.apple.coreanimation.display", 31) == 0) {
+		f = TH_SFLAG_SWEET_UI_DISPLAY;
+	} else if (strncmp(name, "com.apple.coreanimation.render-server", 37) == 0) {
+		f = TH_SFLAG_SWEET_UI_RS;
+	}
+	if (f == 0 && !(th->sched_flags & TH_SFLAG_SWEET_UI_MASK)) {
+		return;
+	}
+	spl_t s = splsched();
+	thread_lock(th);
+	th->sched_flags = (th->sched_flags & ~TH_SFLAG_SWEET_UI_MASK) | f;
+	thread_unlock(th);
+	splx(s);
+	if (f != 0 && os_atomic_inc(&sweet_ui_tagged, relaxed) <= 16) {
+		printf("SWEET UI: tagged thread %llu %s (0238 class %d, kern.sweet_ui_bigcore %d)\n", thread_tid(th), name,
+		    f == TH_SFLAG_SWEET_UI_DISPLAY ? 1 : 2, sweet_ui_mode());
+	}
+}
+
+/* pset locked, interrupts off: atomics and plain stores only (0238 v2) */
+static void
+sweet_ui_count(thread_t thread, processor_t bp, int preempt)
+{
+	os_atomic_inc(preempt ? &sweet_ui_preempt_n : &sweet_ui_idle_n, relaxed);
+	if (__improbable(os_atomic_cmpxchg(&sweet_ui_first_set, 0, 1, relaxed))) {
+		sweet_ui_first_tid = thread->thread_id;
+		sweet_ui_first_cpu = bp->cpu_id;
+		os_atomic_store(&sweet_ui_first_preempt, preempt + 1, release);   /* 0 = fields not yet written */
+	}
+}
+
 processor_t
 choose_processor(
 	processor_set_t         starting_pset,
@@ -5077,6 +5146,36 @@ choose_processor(
 				}
 			}
 		}
+		/* 0238 (redfin 1041): a tagged CA thread takes an idle big core, else preempts a lower-priority one */
+		int ui = ((thread->sched_flags & TH_SFLAG_SWEET_UI_DISPLAY) ? 1 : 0) | ((thread->sched_flags & TH_SFLAG_SWEET_UI_RS) ? 2 : 0);
+		int uimode = os_atomic_load(&sweet_ui_bigcore, relaxed);   /* 0238 v2: no boot-arg parse here; -1 = 0 */
+		if (__improbable(ui != 0) && uimode > 0 && (ui & uimode)) {
+			processor_t idle = PROCESSOR_NULL, low = PROCESSOR_NULL;
+			for (int i = 7; i >= 6; i--) {          /* SWEET_UI_BIG_MASK: CPU7 first, as 0147 */
+				processor_t bp = processor_array[i];
+				if (bp == PROCESSOR_NULL || bp->processor_set != pset || !bp->is_recommended) {
+					continue;
+				}
+				if (bp->state == PROCESSOR_IDLE) {
+					if (idle == PROCESSOR_NULL) {
+						idle = bp;
+					}
+				} else if (bp->state == PROCESSOR_RUNNING && bp->current_pri < thread->sched_pri &&
+				    !bit_test(pset->pending_AST_URGENT_cpu_mask, bp->cpu_id) &&
+				    (low == PROCESSOR_NULL || bp->current_pri < low->current_pri)) {
+					low = bp;
+				}
+			}
+			if (idle != PROCESSOR_NULL) {
+				processor = idle;       /* an idle hint is taken as is below */
+				sweet_ui_count(thread, idle, 0);
+			} else if (low != PROCESSOR_NULL && thread->sched_pri < BASEPRI_RTQUEUES) {
+				/* 0238 v2: RT threads never preempt a running big core here (idle hint only) */
+				sweet_ui_count(thread, low, 1);
+				return low;             /* pset locked; processor_setrun preempts it */
+			}
+			/* else the normal choice: never waits for a big core */
+		}
 	}
 #endif
 
diff --git a/osfmk/kern/thread.h b/osfmk/kern/thread.h
index 242233a..74ccec2 100644
--- a/osfmk/kern/thread.h
+++ b/osfmk/kern/thread.h
@@ -471,6 +471,9 @@ struct thread {
 #define TH_SFLAG_PROMOTE_REASON_MASK    (TH_SFLAG_RW_PROMOTED | TH_SFLAG_WAITQ_PROMOTED | TH_SFLAG_EXEC_PROMOTED | TH_SFLAG_FLOOR_PROMOTED)
 
 #define TH_SFLAG_RT_DISALLOWED         0x100000         /* thread wants RT but may not have joined a work interval that allows it */
+#define TH_SFLAG_SWEET_UI_RS           0x20000000       /* sunfish 0238 (redfin 1041): named com.apple.coreanimation.render-server* */
+#define TH_SFLAG_SWEET_UI_DISPLAY      0x40000000       /* sunfish 0238 (redfin 1041): named com.apple.coreanimation.display* */
+#define TH_SFLAG_SWEET_UI_MASK         (TH_SFLAG_SWEET_UI_RS | TH_SFLAG_SWEET_UI_DISPLAY)
 #define TH_SFLAG_DEMOTED_MASK      (TH_SFLAG_THROTTLED | TH_SFLAG_FAILSAFE | TH_SFLAG_RT_DISALLOWED)     /* saved_mode contains previous sched_mode */
 
 	int16_t                 sched_pri;              /* scheduled (current) priority */
