 bsd/dev/sweet_cpufreq.c | 52 ++++++++++++++++++++++++++
 bsd/kern/proc_info.c    |  6 +++
 osfmk/kern/sched_prim.c | 99 +++++++++++++++++++++++++++++++++++++++++++++++++
 osfmk/kern/thread.h     |  3 ++
 4 files changed, 160 insertions(+)

diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 23f7ffd..472bc2d 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -11,6 +11,8 @@
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 
@@ -88,4 +90,54 @@ sweet_cpufreq_init(void)
 		    osm_clusters[c].name, cur, best, best_khz / 1000, osm_rd(base, OSM_DESIRED));
 	}
 }
+
+/*
+ * 0238 (ios-redfin 1041, MIT): kern.sweet_ui_bigcore MASK (osfmk/kern/sched_prim.c, choose_processor): 1 CA display
+ * threads, 2 render-server threads on the A76 cores (CPU6/7); default 1, boot-arg sweetuibig=N, 0 off.
+ */
+extern int sweet_ui_bigcore;
+extern int sweet_ui_mode(void);
+static int
+sysctl_sweet_ui_bigcore SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = sweet_ui_mode(), changed = 0;
+	int error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 0 || value > 3) {
+		return EINVAL;
+	}
+	sweet_ui_bigcore = value;
+	printf("SWEET UI: bigcore %d (0238: 1 CA display, 2 render-server threads on CPU6/7)\n", value);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ui_bigcore, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ui_bigcore, "I", "SWEET UI: CA threads on the big cores (1 display, 2 render-server; 0 off)");
+
+/* 0238 v2: choose_processor counts placements lock-free (no printf under the pset lock); read-only here */
+extern uint32_t sweet_ui_idle_n, sweet_ui_preempt_n;
+extern uint64_t sweet_ui_first_tid;
+extern int sweet_ui_first_cpu, sweet_ui_first_preempt;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_ui_idle, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_ui_idle_n, 0,
+    "SWEET UI: tagged CA thread placements on an idle big core");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_ui_preempt, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_ui_preempt_n, 0,
+    "SWEET UI: tagged CA thread placements preempting a big core");
+static int
+sysctl_sweet_ui_first SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[64];
+	int how = os_atomic_load(&sweet_ui_first_preempt, acquire);
+	if (how == 0) {
+		snprintf(buf, sizeof(buf), "none");
+	} else {
+		snprintf(buf, sizeof(buf), "tid %llu cpu %d %s", sweet_ui_first_tid, sweet_ui_first_cpu,
+		    how == 2 ? "preempt" : "idle");
+	}
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ui_first, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ui_first, "A", "SWEET UI: first big-core placement (tid, cpu, idle|preempt)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
