 {
@@ -959,6 +962,9 @@ bsd_setthreadname(void *uth, const char *name)
 
 	strncpy(ut->pth_name, name, MAXTHREADNAMESIZE - 1);
 	kernel_debug_string_simple(TRACE_STRING_THREADNAME, ut->pth_name);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
