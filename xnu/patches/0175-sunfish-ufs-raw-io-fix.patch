From 51e31447544e98ad3f30a27c9d26185ff5c26a23 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Sun, 25 Oct 2026 17:44:59 -0400
Subject: [PATCH] sunfish: UFS raw I/O via copyout/copyin, LBA range check,
 geometry and timeout logs

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_ufs.c | 45 +++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 41 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 50acc55..1a0150f 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -224,8 +224,12 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	while (ufs_rd(REG_UTRLDBR) & 1) {
 		uint64_t now = mach_absolute_time();
 		if (now > deadline) {
+			/* 0175: controller state at the timeout, then clear IS (write-1-to-clear). */
+			uint32_t is = ufs_rd(REG_IS), hcs = ufs_rd(REG_HCS), dbr = ufs_rd(REG_UTRLDBR);
 			ufs_wr(REG_UTRLCLR, ~1u);
-			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			printf("SWEET UFS: command 0x%02x timed out: IS 0x%x HCS 0x%x UTRLDBR 0x%x\n",
+			    cdb[0], is, hcs, dbr);
+			ufs_wr(REG_IS, is);
 			return ETIMEDOUT;
 		}
 		if (sleepable && now >= spin_until) {
@@ -265,7 +269,14 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 static int
 ufs_read_blocks(uint64_t lba, uint32_t count)
 {
-	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+	if (lba > UINT32_MAX || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	/* 0175: once the partition is known, reads stay inside it (find_partition runs before). */
+	if (su.ready && su.nblocks &&
+	    (lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block))) {
+		printf("SWEET UFS: read lba %llx+%u outside userdata\n", lba, count);
 		return EINVAL;
 	}
 	uint8_t cdb[10] = {
@@ -304,6 +315,16 @@ ufs_sync_cache(void)
 	return ufs_scsi(cdb, sizeof(cdb), 0, false);
 }
 
+/* 0175: 1025 XNU log + 64 scratch + 64 rescue blocks at the end (shim/ufs.h). */
+#define UFS_RESCUE_TAIL         1153u
+
+static void
+ufs_log_geometry(void)
+{
+	printf("SWEET UFS: userdata first block %llx, %llu blocks, rescue at +%llx\n",
+	    su.first_block, su.nblocks, su.nblocks - UFS_RESCUE_TAIL);
+}
+
 static int
 ufs_find_partition(const char *want)
 {
@@ -446,7 +467,14 @@ sweet_ufs_strategy(buf_t bp)
 		if (rd) {
 			error = ufs_read_blocks(su.first_block + lba, blocks);
 			if (!error) {
-				memcpy(vaddr + done, (const char *)bounce + skip, want);
+				if (buf_flags(bp) & B_PHYS) {
+					/* 0175: raw I/O, vaddr is the user's address (physio sets
+					 * b_datap to the iov base; buf_map returns it unchanged). */
+					error = copyout((const char *)bounce + skip,
+					    (user_addr_t)(uintptr_t)(vaddr + done), want);
+				} else {
+					memcpy(vaddr + done, (const char *)bounce + skip, want);
+				}
 			}
 		} else {
 			/* Partial device blocks at either end: read, merge, write back. */
@@ -454,7 +482,14 @@ sweet_ufs_strategy(buf_t bp)
 				error = ufs_read_blocks(su.first_block + lba, blocks);
 			}
 			if (!error) {
-				memcpy((char *)bounce + skip, vaddr + done, want);
+				if (buf_flags(bp) & B_PHYS) {
+					error = copyin((user_addr_t)(uintptr_t)(vaddr + done),
+					    (char *)bounce + skip, want);
+				} else {
+					memcpy((char *)bounce + skip, vaddr + done, want);
+				}
+			}
+			if (!error) {
 				error = ufs_write_blocks(su.first_block + lba, blocks);
 			}
 		}
@@ -659,6 +694,7 @@ sweet_ufs_init(void)
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	ufs_log_geometry();
 	sweet_log_start();
 	sweet_sample_start();
 	sweet_cpufreq_init();
@@ -843,6 +879,7 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	ufs_log_geometry();     /* 0175: again, so it reaches the live log */
 	for (;;) {
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-- 
2.56.0

