From e521476d9acade69b6ba48ecbfdb89e348b2b8a3 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Fri, 30 Oct 2026 07:57:28 -0400
Subject: [PATCH] 0239 sunfish: backlight publishes new-backlight-architecture
 (CoreBrightness nits path), sweetblnew=0 off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetBacklight.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/iokit/Kernel/arm/SweetBacklight.cpp b/iokit/Kernel/arm/SweetBacklight.cpp
index 33f60a3..72ce11e 100644
--- a/iokit/Kernel/arm/SweetBacklight.cpp
+++ b/iokit/Kernel/arm/SweetBacklight.cpp
@@ -80,6 +80,13 @@ AppleARMBacklight::start(IOService *provider)
 	setProperty("name", "backlight");
 	setProperty("compatible", "backlight,sweet");
 	setProperty("backlight-control", kOSBooleanTrue);
+	/* 0239: CoreBrightness's nits path (fades write brightness-nits, not the legacy brightness thread); sweetblnew=0 off */
+	uint32_t blnew = 1;
+	(void)PE_parse_boot_argn("sweetblnew", &blnew, sizeof(blnew));
+	if (blnew) {
+		setProperty("new-backlight-architecture", kOSBooleanTrue);
+		IOLog("SWEET BL: new-backlight-architecture on\n");
+	}
 
 	OSDictionary *params = OSDictionary::withCapacity(1);
 	OSDictionary *bright = OSDictionary::withCapacity(3);
-- 
2.56.0

