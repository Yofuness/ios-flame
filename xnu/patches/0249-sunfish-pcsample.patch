From d8026387a60840c0a224ab48e35268e548f6c1fa Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Fri, 30 Oct 2026 21:36:59 -0400
Subject: [PATCH] 0249 sunfish: kern.sweet_pcsample captures 8000 PCs of
 backboardd's busiest thread (or a tid) with sweetcpusample=1, xcall to read
 the other CPU's interrupted PC, logged from a thread as SWEET PC: lines

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_cpusample.c | 210 ++++++++++++++++++++++++++++++++++++++
 osfmk/arm64/cpu.c         |  29 ++++++
 2 files changed, 239 insertions(+)

diff --git a/bsd/dev/sweet_cpusample.c b/bsd/dev/sweet_cpusample.c
index 75bd02e..344d399 100644
--- a/bsd/dev/sweet_cpusample.c
+++ b/bsd/dev/sweet_cpusample.c
@@ -9,24 +9,44 @@
  *   SWEET CPU: 5s: <proc> tid <n> <name>: <ms> ms (A55 <ms>, A76 <ms>)   (top 4)
  *   SWEET CPU: 5s: busy% c0 .. c7
  * and swaps two tables, so the timer never meets a lock; no allocation in the timer.
+ *
+ * 0249: PC capture of one thread, only with the sampler on. Write kern.sweet_pcsample (quad): 1 = backboardd's
+ * busiest thread of the next 5 s report, >1 = that tid. Each tick that finds the thread on a CPU reads its
+ * interrupted PC there: directly on this CPU, else with one immediate xcall (never spins on a busy target, a miss is
+ * counted). A kernel thread then logs PC_N samples (or what it has after PC_LIMIT_S) from thread context:
+ *   SWEET PC: armed / meta pid .. dsc_start .. slide .. kslide .. / img 0x<base> <path> / tid <t> @<index> <hex pcs>
+ *   SWEET PC: done tid <t> n .. user .. kernel .. missed ..
+ * Nothing is logged from the timer or the xcall. tools/sunfish-pc-hist.py reads the lines.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/proc.h>
+#include <sys/proc_internal.h>
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <kern/clock.h>
 #include <kern/timer_call.h>
 #include <kern/sched_prim.h>
+#include <kern/thread_call.h>
+#include <mach/shared_region.h>
+#include <vm/vm_shared_region.h>
+#include <sys/sysctl.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 #include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
 
 extern void thread_deallocate(thread_t);
 extern thread_t sweet_cpu_active_thread(int cpu, int *idle);   /* osfmk/kern/thread.c */
 extern int hz;
 void sweet_cpusample_init(void);
+extern int sweet_cpu_int_pc(uint64_t *pc);     /* 0249: osfmk/arm64/cpu.c */
+extern int sweet_cpu_sample_signal(int cpu, void (*f)(void *), void *p);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+extern kern_return_t copyinmap(vm_map_t, vm_map_offset_t, void *, vm_size_t);
+extern vm_offset_t vm_kernel_slide;
 
 #define CS_CPUS     8
 #define CS_FIRST_A76 6
@@ -42,6 +62,37 @@ static struct cs_tab cs_tabs[2];
 static volatile uint32_t cs_cur;
 static timer_call_t cs_timer;
 
+/* 0249: PC capture. pc_state is only written by the sysctl (IDLE only), cs_report (ARM), the xcall and the printer. */
+#define PC_N         8000
+#define PC_PER_LINE  8
+#define PC_LINE_DIV  20         /* one line per hz/20 ticks: 50 ms, 20 lines/s */
+#define PC_LIMIT_S   60
+#define PC_MAX_IMG   64
+enum { PCS_IDLE, PCS_SETUP, PCS_ARM, PCS_RUN, PCS_FULL };
+static volatile SInt32 pc_state;
+static volatile uint64_t pc_tid;
+static volatile int pc_pid;
+static volatile SInt32 pc_n;
+static uint32_t pc_missed;
+static uint64_t pc_buf[PC_N];
+
+/* Runs on the CPU of the thread, in interrupt context: from the tick itself or from the xcall. */
+static void
+pc_take(__unused void *p)
+{
+	uint64_t pc;
+	if (pc_state != PCS_RUN || thread_tid(current_thread()) != pc_tid || sweet_cpu_int_pc(&pc) < 0) {
+		return;         /* it left the CPU before the xcall landed, or no saved state */
+	}
+	SInt32 i = OSIncrementAtomic(&pc_n);
+	if (i < PC_N) {
+		pc_buf[i] = pc;
+	}
+	if (i >= PC_N - 1) {
+		pc_state = PCS_FULL;
+	}
+}
+
 static void
 cs_tick(__unused void *p0, __unused void *p1)
 {
@@ -65,6 +116,12 @@ cs_tick(__unused void *p0, __unused void *p1)
 			continue;       /* kernel threads: busy only */
 		}
 		uint64_t tid = thread_tid(th);
+		if (__improbable(pc_state == PCS_RUN) && tid == pc_tid) {
+			pc_pid = pid;
+			if (sweet_cpu_sample_signal(c, pc_take, pc_buf) != 0) {
+				pc_missed++;    /* last xcall still pending, or CPU going down */
+			}
+		}
 		struct cs_ent *e = NULL, *min = &t->e[0];
 		for (int i = 0; i < CS_N; i++) {
 			struct cs_ent *x = &t->e[i];
@@ -116,6 +173,11 @@ cs_report(struct cs_tab *t)
 			if (!best) {
 				break;
 			}
+			if (w == 0 && k == 0 && pc_state == PCS_ARM) {  /* 0249: pick the busiest */
+				pc_pid = best->pid;
+				pc_tid = best->tid;
+				pc_state = PCS_RUN;
+			}
 			uint32_t ms = (best->a55 + best->a76) * CS_TICK_US / 1000;
 			printf("SWEET CPU: 5s: %s tid %llu -: %u ms (A55 %u, A76 %u)\n", want, best->tid,
 			    ms, best->a55 * CS_TICK_US / 1000, best->a76 * CS_TICK_US / 1000);
@@ -130,6 +192,150 @@ cs_report(struct cs_tab *t)
 	printf("SWEET CPU: 5s: busy%%%s\n", line);
 }
 
+/* 0249: the task's shared cache slide and the images outside the cache, so a PC can be named. */
+static void
+pc_log_images(int chan)
+{
+	proc_t p = proc_find(pc_pid);
+	task_t task = p ? proc_task(p) : TASK_NULL;
+	if (task == TASK_NULL) {
+		printf("SWEET PC: meta pid %d gone\n", pc_pid);
+		goto out;
+	}
+	char name[32];
+	mach_vm_offset_t start = 0;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		if (vm_shared_region_start_address(sr, &start, NULL) != KERN_SUCCESS) {
+			start = 0;
+		}
+		vm_shared_region_deallocate(sr);
+	}
+	proc_name(pc_pid, name, sizeof(name));
+	printf("SWEET PC: meta pid %d name %s dsc_start 0x%llx slide 0x%llx kslide 0x%llx\n", pc_pid, name, (uint64_t)start,
+	    start ? (uint64_t)start - SHARED_REGION_BASE_ARM64 : 0, (uint64_t)vm_kernel_slide);
+
+	/* struct dyld_all_image_infos starts { u32 version, u32 count, u64 array }; entries { u64 base, u64 path, u64 date } */
+	struct { uint32_t version, count; uint64_t array; } hdr;
+	vm_map_t map = get_task_map(task);
+	uint64_t aii = task_get_all_image_info_addr(task);
+	if (!aii || copyinmap(map, aii, &hdr, sizeof(hdr)) != KERN_SUCCESS || !hdr.array) {
+		printf("SWEET PC: meta no image list\n");
+		goto out;
+	}
+	uint32_t shown = 0;
+	for (uint32_t i = 0; i < MIN(hdr.count, 4096u) && shown < PC_MAX_IMG; i++) {
+		uint64_t e[3];
+		char path[112];
+		if (copyinmap(map, hdr.array + i * sizeof(e), e, sizeof(e)) != KERN_SUCCESS) {
+			break;
+		}
+		if (start && e[0] >= start && e[0] < SHARED_REGION_BASE_ARM64 + SHARED_REGION_SIZE_ARM64 + (start - SHARED_REGION_BASE_ARM64)) {
+			continue;       /* in the cache: the tool names those from the slide */
+		}
+		size_t len = MIN(sizeof(path) - 1, 0x1000 - (e[1] & 0xfff));    /* stay within the page */
+		path[0] = 0;
+		if (copyinmap(map, e[1], path, len) == KERN_SUCCESS) {
+			path[len] = 0;
+		} else {
+			path[0] = 0;
+		}
+		printf("SWEET PC: img 0x%llx %s\n", e[0], path);
+		shown++;
+		(void)tsleep(&chan, PZERO, "sweetpc", MAX(1, hz / PC_LINE_DIV));
+	}
+out:
+	if (p) {
+		proc_rele(p);
+	}
+}
+
+/* 0249: waits for the window, then logs it. A thread of its own: the 5 s tick holds the GPU lock. */
+static void
+pc_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int chan = 0, waited = 0;
+	printf("SWEET PC: armed tid %llu\n", pc_tid);
+	while (pc_state != PCS_FULL && waited < PC_LIMIT_S * 10) {
+		(void)tsleep(&chan, PZERO, "sweetpc", MAX(1, hz / 10));
+		waited++;
+	}
+	pc_state = PCS_FULL;
+	(void)tsleep(&chan, PZERO, "sweetpc", MAX(1, hz / 10));       /* let an xcall in flight finish */
+
+	uint32_t n = MIN((uint32_t)pc_n, PC_N), user = 0, kern = 0;
+	uint64_t tid = pc_tid;
+	if (pc_tid) {
+		pc_log_images(chan);
+	}
+	for (uint32_t i = 0; i < n;) {
+		char line[160];
+		size_t l = 0;
+		uint32_t first = i;
+		for (int j = 0; j < PC_PER_LINE && i < n; j++, i++) {
+			l += snprintf(line + l, sizeof(line) - l, " %llx", pc_buf[i]);
+			if (pc_buf[i] >> 63) {
+				kern++;
+			} else {
+				user++;
+			}
+		}
+		printf("SWEET PC: tid %llu @%u%s\n", tid, first, line);
+		(void)tsleep(&chan, PZERO, "sweetpc", MAX(1, hz / PC_LINE_DIV));
+	}
+	printf("SWEET PC: done tid %llu n %u user %u kernel %u missed %u waited %d ms\n", tid, n, user, kern, pc_missed,
+	    waited * 100);
+	pc_state = PCS_IDLE;
+	(void)thread_terminate(current_thread());
+}
+
+static int
+sysctl_sweet_pcsample SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t v = (uint64_t)pc_state;
+	int err = SYSCTL_OUT(req, &v, sizeof(v));
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	v = 0;
+	if (req->newlen != sizeof(v) && req->newlen != sizeof(uint32_t)) {
+		return EINVAL;
+	}
+	if ((err = SYSCTL_IN(req, &v, req->newlen)) != 0 || v == 0) {
+		return err;
+	}
+	if (!OSCompareAndSwap(PCS_IDLE, PCS_SETUP, (volatile UInt32 *)&pc_state)) {
+		return EBUSY;
+	}
+	bzero(pc_buf, sizeof(pc_buf));
+	pc_n = 0;
+	pc_missed = 0;
+	pc_pid = 0;
+	pc_tid = v > 1 ? v : 0;
+	thread_t thread;
+	if (kernel_thread_start(pc_thread, NULL, &thread) != KERN_SUCCESS) {
+		pc_state = PCS_IDLE;
+		return ENOMEM;
+	}
+	thread_deallocate(thread);
+	pc_state = v > 1 ? PCS_RUN : PCS_ARM;
+	return 0;
+}
+
+/* Manual OID as in 0195 (sweet_spmi.c): permanent nodes panic after lockdown. */
+SYSCTL_OID_MANUAL(_kern, OID_AUTO, sweet_pcsample,
+    CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_NOAUTO,
+    0, 0, sysctl_sweet_pcsample, "Q", "sunfish PC capture: 1 busiest backboardd thread, >1 tid (0249)");
+
+/* A thread call: the 5 s tick holds the GPU lock, and registering waits for sysctl handlers that may take it. */
+static void
+pc_register(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	sysctl_register_oid(&sysctl__kern_sweet_pcsample);
+	printf("SWEET PC: kern.sweet_pcsample ready\n");
+}
+
 /*
  * Driven by sweet_gpu.c's 5 s stats tick (a context known to log): the first call parses the boot-arg and
  * starts the 1 kHz timer, each later call reports the table the timer filled and switches it to the other.
@@ -150,6 +356,10 @@ sweet_cpusample_tick5s(void)
 			timer_call_enter(cs_timer, dl, TIMER_CALL_SYS_CRITICAL);
 			state = 2;
 			printf("SWEET CPU: sampler started\n");
+			thread_call_t reg = thread_call_allocate(pc_register, NULL);    /* 0249 */
+			if (reg) {
+				thread_call_enter(reg);
+			}
 		}
 		return;
 	}
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 4b3729b..1072df1 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -1309,4 +1309,33 @@ sweet_cpu_active_thread(int cpu, int *idle)
 	*idle = (t != THREAD_NULL) && ((t->options & TH_OPT_IDLE_THREAD) != 0);
 	return t;
 }
+
+/*
+ * 0249: the PC this CPU was interrupted at, in interrupt context only: 1 user, 0 kernel, -1 no saved state.
+ * The PCB's user state would be stale (it is written on traps from EL0, not while the thread runs).
+ */
+int
+sweet_cpu_int_pc(uint64_t *pc)
+{
+	arm_saved_state_t *s = getCpuDatap()->cpu_int_state;
+	if (s == NULL) {
+		return -1;
+	}
+	*pc = get_saved_state_pc(s);
+	return PSR64_IS_USER(get_saved_state_cpsr(s)) ? 1 : 0;
+}
+
+/*
+ * 0249: run f(p) on a CPU from interrupt context. Immediate xcall: returns at once if one is pending, where a
+ * normal xcall spins and panics on the ack timeout. 0 when run or sent.
+ */
+int
+sweet_cpu_sample_signal(int cpu, void (*f)(void *), void *p)
+{
+	if (cpu == getCpuDatap()->cpu_number) {
+		f(p);
+		return 0;
+	}
+	return cpu_immediate_xcall(cpu, f, p) == KERN_SUCCESS ? 0 : -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
-- 
2.56.0

