-SweetBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+AppleARMBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type,
     IOUserClient **handler)
 {
 	(void)owningTask; (void)securityID; (void)handler;
@@ -132,7 +169,7 @@ SweetBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type,
 }
 
 bool
-SweetBacklight::handleOpen(IOService *forClient, IOOptionBits options, void *arg)
+AppleARMBacklight::handleOpen(IOService *forClient, IOOptionBits options, void *arg)
 {
 	IOLog("SWEET BL: open by %s\n",
 	    forClient ? forClient->getMetaClass()->getClassName() : "(null)");
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 60215d0..a03f283 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -166,10 +166,14 @@ public:
 	bool          fPanelFailed;   /* a DMA timed out this off period: fade only */
 	bool          fPanelReq;      /* wakes panelLoop */
 	uint32_t      fPanelAR;       /* saved MDP autorefresh */
+	uint16_t      fBLReq;         /* 0209: DCS 51 value to send (4..511), 0 = none; panelLoop sends it awake */
+	uint64_t      fPropLog[5];    /* 0209: last log time per brightness key */
 	static void panelLoop(void *arg);
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
 };
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
+static AppleCLCD *sweet_clcd;	/* 0209: for sweet_panel_brightness */
 
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
@@ -287,8 +291,11 @@ AppleCLCD::start(IOService *provider)
 
 	uint32_t ps = 0;	/* 0201 */
 	PE_parse_boot_argn("sweetpanelsleep", &ps, sizeof(ps));
-	if (ps != 0 && IOCreateThread(&AppleCLCD::panelLoop, this) != NULL) {
-		fPanelSleep = true;
+	uint32_t bl = 0;	/* 0209: sweetbl=2 needs panelLoop for DCS 51 */
+	PE_parse_boot_argn("sweetbl", &bl, sizeof(bl));
+	sweet_clcd = this;
+	if ((ps != 0 || bl >= 2) && IOCreateThread(&AppleCLCD::panelLoop, this) != NULL) {
+		fPanelSleep = ps != 0;
 	}
 
 	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
@@ -564,6 +571,89 @@ sweet_dsi_dcs_short(uint8_t cmd)
 	return done;
 }
 
+/* 0209: DCS long write 51 HH LL (10-bit brightness), as tools/sunfish-panel-bright.sh. Only 4..511; never 0x53. */
+static bool
+sweet_dsi_dcs_brightness(uint16_t v)
+{
+	if (v < 4 || v > 511) {
+		return false;
+	}
+	if (sweet_dsi[0] != 0x20030000 || (sweet_dsi[0x4 / 4] & 1) == 0) {
+		printf("SWEET PANEL: DSI0 version %x ctrl %x: refused\n", sweet_dsi[0], sweet_dsi[0x4 / 4]);
+		return false;
+	}
+	volatile uint32_t *ar = sweet_mdp + 0xab4 / 4;
+	uint32_t a = *ar;
+	if ((a >> 31) == 0) {
+		printf("SWEET PANEL: dcs 51 refused, autorefresh %x\n", a);
+		return false;
+	}
+	sweet_dcsbuf[0] = 0xC0390003;   /* LAST | long write 39 | 3 bytes */
+	sweet_dcsbuf[1] = 0xFF000051 | ((uint32_t)(v >> 8) << 8) | ((uint32_t)(v & 0xff) << 16);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*ar = 0;
+	IOSleep(30);
+	sweet_dsi[0x110 / 4] |= 1;
+	sweet_dsi[0x48 / 4] = SWEET_DCS_BUF;
+	sweet_dsi[0x4c / 4] = 8;
+	sweet_dsi[0x90 / 4] = 1;
+	uint32_t t = 0;
+	bool done = false;
+	while (!(done = (sweet_dsi[0x110 / 4] & 1) != 0) && t < 200) {
+		IOSleep(1);
+		t++;
+	}
+	uint32_t ack = sweet_dsi[0x68 / 4];
+	*ar = a;
+	sweet_dsi[0x110 / 4] |= 1;
+	printf("SWEET PANEL: dcs 51 %u done %d t %u ms ack %x\n", v, done, t, ack);
+	return done;
+}
+
+/* 0209: SweetBacklight (sweetbl=2) asks for a value; panelLoop sends the latest, at most every 50 ms. */
+extern "C" void
+sweet_panel_brightness(uint16_t v)
+{
+	AppleCLCD *fb = sweet_clcd;
+	if (fb == NULL || v < 4 || v > 511) {
+		return;
+	}
+	IOLockLock(fb->fLock);
+	fb->fBLReq = v;
+	fb->fPanelReq = true;
+	IOLockWakeup(fb->fLock, &fb->fPanelReq, true);
+	IOLockUnlock(fb->fLock);
+}
+
+/* 0209: CoreBrightness sets these on the IOMFB service: accept, store, log once per second per key. */
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	static const char *keys[5] = { "IOMFBBrightnessLevel", "AmbientBrightness", "TrustedLux",
+		                       "DisplayAAPFactor", "IOMFBContrastEnhancerStrength" };
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	bool any = false;
+	for (int i = 0; i < 5; i++) {
+		OSObject *o = dict->getObject(keys[i]);
+		if (o == NULL) {
+			continue;
+		}
+		any = true;
+		setProperty(keys[i], o);
+		uint64_t now = mach_absolute_time(), ns;
+		absolutetime_to_nanoseconds(now - fPropLog[i], &ns);
+		if (fPropLog[i] == 0 || ns >= 1000000000ULL) {
+			fPropLog[i] = now;
+			OSNumber *n = OSDynamicCast(OSNumber, o);
+			IOLog("SWEET FB: %s = %lld\n", keys[i], n ? (long long)n->unsigned64BitValue() : -1LL);
+		}
+	}
+	return any ? kIOReturnSuccess : IOMobileFramebuffer::setProperties(properties);
+}
+
 /* 0201: own thread; sleeps the panel when off and black, wakes it when on. Re-checks, so the latest request wins. */
 void
 AppleCLCD::panelLoop(void *arg)
@@ -584,7 +674,10 @@ AppleCLCD::panelLoop(void *arg)
 	for (;;) {
 		IOLockLock(fb->fLock);
 		bool sleep, own = false;
-		while ((sleep = fb->fPowerOff && fb->fFadeStep > 6 && !fb->fPanelFailed) == fb->fPanelAsleep) {
+		while ((sleep = fb->fPanelSleep && fb->fPowerOff && fb->fFadeStep > 6 && !fb->fPanelFailed) == fb->fPanelAsleep) {
+			if (fb->fBLReq != 0 && !fb->fPanelAsleep) {
+				break;	/* 0209: brightness while awake; asleep keeps it for after the wake */
+			}
 			fb->fPanelReq = false;
 			if (!fb->fPowerOff || fb->fPanelAsleep || fb->fPanelFailed) {
 				off0 = 0;
@@ -609,6 +702,14 @@ AppleCLCD::panelLoop(void *arg)
 			clock_interval_to_deadline(10, kMillisecondScale, &dl);
 			IOLockSleepDeadline(fb->fLock, &fb->fPanelReq, dl, THREAD_UNINT);
 		}
+		if (sleep == fb->fPanelAsleep) {	/* 0209: only a brightness request */
+			uint16_t v = fb->fBLReq;
+			fb->fBLReq = 0;
+			IOLockUnlock(fb->fLock);
+			sweet_dsi_dcs_brightness(v);
+			IOSleep(50);	/* rate limit; later requests coalesce into fBLReq */
+			continue;
+		}
 		uint32_t fade = fb->fFadeStep;
 		if (sleep) {
 			fb->fPanelAsleep = true;	/* 0203: no present from the first DCS on; a half sleep-in still gets 11/29 */
