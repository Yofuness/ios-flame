 void
-SweetBacklight::logValue(const char *key, OSObject *value)
+AppleARMBacklight::logValue(const char *key, OSObject *value)
 {
 	char buf[201];
 	buf[0] = '\0';
@@ -97,8 +105,32 @@ SweetBacklight::logValue(const char *key, OSObject *value)
 	IOLog("SWEET BL: setProperties key %s = %s\n", key, buf);
 }
 
+/* 0209: 16.16 nits from CoreBrightness: keep read-backs current, drive the panel with sweetbl=2. */
+void
+AppleARMBacklight::setNits(uint32_t raw)
+{
+	uint32_t nits = raw >> 16;
+	IOLog("SWEET BL: nits %u (raw %x)\n", nits, raw);
+	putNumber(NULL, "brightness-nits", raw);
+	uint32_t c = nits > 500 ? 500 : nits;
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *bright = OSDictionary::withCapacity(3);
+	if (params && bright) {
+		putNumber(bright, "min", 0);
+		putNumber(bright, "max", 65536);
+		putNumber(bright, "value", c * 65536 / 500);
+		params->setObject("brightness", bright);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(bright);
+	OSSafeReleaseNULL(params);
+	if (fMode >= 2) {
+		sweet_panel_brightness((uint16_t)(4 + c * (511 - 4) / 500));
+	}
+}
+
 IOReturn
-SweetBacklight::setProperties(OSObject *properties)
+AppleARMBacklight::setProperties(OSObject *properties)
 {
 	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
 	if (!dict) {
@@ -113,7 +145,12 @@ SweetBacklight::setProperties(OSObject *properties)
 	while ((key = OSDynamicCast(OSSymbol, it->getNextObject()))) {
 		OSObject *value = dict->getObject(key);
 		logValue(key->getCStringNoCopy(), value);
-		/* Store it so a read-back sees the new value. */
+		OSNumber *n = OSDynamicCast(OSNumber, value);
+		if (n && key->isEqualTo("brightness-nits")) {
+			setNits(n->unsigned32BitValue());
+			continue;
+		}
+		/* Store it so a read-back sees the new value (also brightness-nits-cap, BLNitsCap). */
 		if (value) {
 			setProperty(key, value);
 		}
@@ -123,7 +160,7 @@ SweetBacklight::setProperties(OSObject *properties)
 }
 
