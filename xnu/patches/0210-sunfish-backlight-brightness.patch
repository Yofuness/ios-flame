 	return IOService::probe(provider, score);
 }
 
 void
-SweetBacklight::putNumber(OSDictionary *d, const char *key, UInt32 value)
+AppleARMBacklight::putNumber(OSDictionary *d, const char *key, UInt32 value)
 {
 	OSNumber *n = OSNumber::withNumber(value, 32);
 	if (n) {
@@ -52,7 +60,7 @@ SweetBacklight::putNumber(OSDictionary *d, const char *key, UInt32 value)
 }
 
