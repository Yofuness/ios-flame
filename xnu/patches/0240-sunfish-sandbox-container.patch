From 1c472ff90a9cce532eb1dfa4db7162635c6a5c83 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Fri, 30 Oct 2026 09:19:13 -0400
Subject: [PATCH] 0240 sunfish: Sandbox op 4 answers the container path from
 the spawn attributes (app extensions), sweetsbcont=0 off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

v1.1 (2026-10-30): NULL instead of PROC_NULL (build fix).
v2 (2026-10-30): bounded blob logging (strings >= 8 chars with offsets + hex 0x00-0x7f, 4 launchd + 32 others), op4 result logging, HOME=/var/mobile/Containers/Data/... fallback from the exec environment (kern_exec.c, after exec_extract_strings). Needs the base commit tracking kern_exec.c (unchanged file).
v3 (2026-10-30): lookup by pid only (the exec-time uniqueid did not match, sb2), op-4 calls after 60 s logged.
v4: entries kept across the exit notification an exec sends for the retired proc (sb3); op4 log aimed at Providers.
v5: the entry is cleared at the start of the HOME scan; the exec hook (later in the same exec) no longer wipes it (sb4).
---
 bsd/kern/sweet_amfi.c | 314 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 313 insertions(+), 1 deletion(-)

diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 8d4012f..58f33d6 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -26,6 +26,7 @@
 #include <kern/clock.h>
 #include <kern/debug.h>
 #include <kern/kalloc.h>
+#include <kern/locks.h>
 #include <IOKit/IOBSD.h>
 #include <kern/startup.h>
 #include <libkern/amfi/amfi.h>
@@ -408,6 +409,351 @@ sweet_sbext_consume(struct proc *p, user_addr_t arg)
 	return 0;
 }
 
+/*
+ * 0240: sandbox container path (op 4). PlugInKit's checkEnvironment asks
+ * sandbox_container_path_for_pid(self) and kills every app extension on
+ * failure. launchd/xpcproxy pass the container in the "Sandbox" spawn
+ * attributes (profile name at +0x10, container path at +0x50); remember it
+ * per pid at exec and answer op 4 from that table. Boot-arg sweetsbcont=0
+ * turns it off (op 4 -> ENOENT as before).
+ */
+#define SWEET_SBCONT_MAX        256
+#define SWEET_SBCONT_PROFILE    0x10
+#define SWEET_SBCONT_PATH       0x50
+static struct {
+	pid_t    pid;
+	uint64_t uniqueid;
+	char     path[MAXPATHLEN];
+} sweet_sbcont[SWEET_SBCONT_MAX];
+static unsigned int sweet_sbcont_next;
+static int sweet_sbcont_logged, sweet_sbcont_blobs_logged;
+static LCK_GRP_DECLARE(sweet_sbcont_grp, "sweet_sbcont");
+static LCK_MTX_DECLARE(sweet_sbcont_mtx, &sweet_sbcont_grp);
+
+static bool
+sweet_sbcont_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetsbcont", &v, sizeof(v));
+		enabled = v != 0;
+	}
+	return enabled;
+}
+
+/* bounded string length of blob[off..len); 0 if out of range */
+static size_t
+sweet_sbcont_strlen(const char *blob, size_t len, size_t off, size_t max)
+{
+	if (len <= off) {
+		return 0;
+	}
+	return strnlen(blob + off, MIN(len - off, max - 1));
+}
+
+static void sweet_sandbox_proc_exit(struct proc *p);
+static void sweet_sandbox_proc_notify_exit(struct proc *p);
+
+/* 0240 v2: is the exec worth logging? not spawned by launchd, or an extension */
+static bool
+sweet_sbcont_interesting(struct proc *p, const char *path)
+{
+	size_t n = strlen(path);
+	if (proc_ppid(p) != 1) {
+		return true;
+	}
+	if (strnstr(path, ".appex/", n) != NULL) {
+		return true;
+	}
+	if (n >= 8 && strcmp(path + n - 8, "Provider") == 0) {
+		return true;
+	}
+	return n >= 9 && strcmp(path + n - 9, "Extension") == 0;
+}
+
+/* 0240 v2: every printable run >= 8 chars with its offset, plus 0x00-0x7f hex */
+static void
+sweet_sbcont_dump(pid_t pid, const char *name, const char *blob, size_t len)
+{
+	size_t i = 0;
+	while (i < len) {
+		size_t j = i;
+		while (j < len && blob[j] >= 0x20 && blob[j] < 0x7f) {
+			j++;
+		}
+		if (j - i >= 8) {
+			printf("SWEET Sandbox:   pid %d @0x%zx '%.*s'\n", pid, i,
+			    (int)MIN(j - i, 200), blob + i);
+		}
+		i = j + 1;
+	}
+	for (size_t row = 0; row < 0x80 && row < len; row += 0x40) {
+		char hex[0x40 * 2 + 1];
+		size_t k;
+		for (k = 0; k < 0x40 && row + k < len; k++) {
+			snprintf(hex + k * 2, 3, "%02x", (unsigned char)blob[row + k]);
+		}
+		hex[k * 2] = '\0';
+		printf("SWEET Sandbox:   pid %d (%s) hex @0x%02zx %s\n", pid, name, row, hex);
+	}
+}
+
+/* store path[0..plen) for p; returns true if this is one of the first 64 */
+static bool
+sweet_sbcont_store(struct proc *p, const char *src, size_t plen)
+{
+	pid_t pid = proc_pid(p);
+	uint64_t uid = proc_uniqueid(p);
+	lck_mtx_lock(&sweet_sbcont_mtx);
+	unsigned int i;
+	for (i = 0; i < SWEET_SBCONT_MAX; i++) {
+		if (sweet_sbcont[i].pid == pid) {
+			break;
+		}
+	}
+	if (i == SWEET_SBCONT_MAX) {
+		i = sweet_sbcont_next++ % SWEET_SBCONT_MAX;       /* oldest overwritten */
+	}
+	sweet_sbcont[i].pid = pid;
+	sweet_sbcont[i].uniqueid = uid;
+	memcpy(sweet_sbcont[i].path, src, plen);
+	sweet_sbcont[i].path[plen] = '\0';
+	bool log = sweet_sbcont_logged < 64;
+	if (log) {
+		sweet_sbcont_logged++;
+	}
+	lck_mtx_unlock(&sweet_sbcont_mtx);
+	return log;
+}
+
+/* exec hook: only records, never asks for a transition or fails the exec */
+static int
+sweet_sandbox_check_execve(kauth_cred_t old __unused, struct vnode *vp,
+    off_t offset __unused, struct vnode *scriptvp __unused,
+    struct label *vnodelabel __unused, struct label *scriptvnodelabel __unused,
+    struct label *execlabel __unused, struct proc *p,
+    void *macpolicyattr, size_t macpolicyattrlen)
+{
+	if (!sweet_sbcont_enabled()) {
+		return 0;
+	}
+	pid_t pid = proc_pid(p);
+	/* v5: no clearing here: this hook runs after the HOME scan of the same exec (it clears instead) */
+	if (macpolicyattr == NULL || macpolicyattrlen == 0) {
+		return 0;
+	}
+	const char *blob = macpolicyattr;
+	size_t plen = sweet_sbcont_strlen(blob, macpolicyattrlen, SWEET_SBCONT_PATH, MAXPATHLEN);
+	char name[32];
+	proc_name(pid, name, sizeof(name));
+	/* 0240 v2: bounded blob logging, 4 launchd spawns + 32 interesting ones */
+	static int launchd_logged;
+	char *vpath = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (vpath != NULL) {
+		int vlen = MAXPATHLEN;
+		if (vp == NULL || vn_getpath(vp, vpath, &vlen) != 0) {
+			strlcpy(vpath, name, MAXPATHLEN);
+		}
+		bool want = false;
+		if (sweet_sbcont_interesting(p, vpath)) {
+			want = sweet_sbcont_blobs_logged < 32;
+			sweet_sbcont_blobs_logged += want;
+		} else {
+			want = launchd_logged < 4;
+			launchd_logged += want;
+		}
+		if (want) {
+			const char *base = strrchr(vpath, '/');
+			base = base ? base + 1 : vpath;
+			printf("SWEET Sandbox: spawn blob pid %d ppid %d (%.48s) len %zu profile %s container %s\n",
+			    pid, proc_ppid(p), base, macpolicyattrlen,
+			    sweet_sbcont_strlen(blob, macpolicyattrlen, SWEET_SBCONT_PROFILE, 64) ? "yes" : "no",
+			    plen ? "yes" : "no");
+			sweet_sbcont_dump(pid, base, blob, macpolicyattrlen);
+		}
+		kfree_data(vpath, MAXPATHLEN);
+	}
+	if (plen == 0) {
+		return 0;
+	}
+	if (sweet_sbcont_store(p, blob + SWEET_SBCONT_PATH, plen)) {
+		printf("SWEET Sandbox: container for pid %d (%s): %.200s\n", pid, name, blob + SWEET_SBCONT_PATH);
+	}
+	return 0;
+}
+
+/*
+ * 0240 v2: fallback from kern_exec.c after exec_extract_strings: if the
+ * spawn blob gave no container, take HOME=/(private/)var/mobile/Containers/
+ * Data/... from the new environment. Only for images under /System,
+ * /Applications or /private/var/containers; stops at the first HOME=.
+ */
+static int sweet_sbcont_home_logged, sweet_sbcont_op4_logged, sweet_sbcont_uidlog;
+
+void sweet_sbcont_exec_env(struct proc *p, const char *path, const char *env, const char *envend);
+void
+sweet_sbcont_exec_env(struct proc *p, const char *path, const char *env, const char *envend)
+{
+	if (!sweet_sbcont_enabled() || path == NULL || env == NULL) {
+		return;
+	}
+	/* v5: a new exec in this pid drops the old entry here, before anything of this exec is stored (the
+	   exec hook runs later in exec_mach_imgact and used to wipe what this scan had just stored: sb4) */
+	sweet_sandbox_proc_exit(p);
+	if (strncmp(path, "/System/", 8) != 0 && strncmp(path, "/Applications/", 14) != 0 &&
+	    strncmp(path, "/private/var/containers/", 24) != 0 &&
+	    strncmp(path, "/var/containers/", 16) != 0) {
+		return;
+	}
+	pid_t pid = proc_pid(p);
+	uint64_t uid = proc_uniqueid(p);
+	bool have = false;
+	lck_mtx_lock(&sweet_sbcont_mtx);
+	for (unsigned int i = 0; i < SWEET_SBCONT_MAX; i++) {
+		if (sweet_sbcont[i].pid == pid && sweet_sbcont[i].uniqueid == uid) {
+			have = true;
+			break;
+		}
+	}
+	lck_mtx_unlock(&sweet_sbcont_mtx);
+	if (have) {
+		return;
+	}
+	for (const char *s = env; s < envend;) {
+		size_t n = strnlen(s, envend - s);
+		if (n > 5 && strncmp(s, "HOME=", 5) == 0) {
+			const char *h = s + 5;
+			if ((strncmp(h, "/private/var/mobile/Containers/Data/", 36) == 0 ||
+			    strncmp(h, "/var/mobile/Containers/Data/", 28) == 0) && n - 5 < MAXPATHLEN) {
+				bool log = sweet_sbcont_store(p, h, n - 5) && sweet_sbcont_home_logged < 32;
+				if (log) {
+					sweet_sbcont_home_logged++;
+					const char *base = strrchr(path, '/');
+					printf("SWEET Sandbox: HOME container for pid %d (%.48s): %.200s\n",
+					    pid, base ? base + 1 : path, h);
+				}
+			}
+			return;
+		}
+		s += n + 1;
+	}
+}
+
+static void
+sweet_sandbox_proc_exit(struct proc *p)
+{
+	pid_t pid = proc_pid(p);
+	lck_mtx_lock(&sweet_sbcont_mtx);
+	for (unsigned int i = 0; i < SWEET_SBCONT_MAX; i++) {
+		if (sweet_sbcont[i].pid == pid) {
+			sweet_sbcont[i].pid = 0;
+			sweet_sbcont[i].path[0] = '\0';
+		}
+	}
+	lck_mtx_unlock(&sweet_sbcont_mtx);
+}
+
+/* v4: the exit notification is not used to drop entries: an exec retires the old proc after the new image's
+   HOME was recorded (sb3: every lookup ENOENT); an entry is replaced at the pid's next exec instead */
+static void
+sweet_sandbox_proc_notify_exit(struct proc *p)
+{
+	static int logged;
+	if (logged < 8) {
+		pid_t pid = proc_pid(p);
+		int had = 0;
+		lck_mtx_lock(&sweet_sbcont_mtx);
+		for (unsigned int i = 0; i < SWEET_SBCONT_MAX; i++) {
+			had |= sweet_sbcont[i].pid == pid && sweet_sbcont[i].path[0] != '\0';
+		}
+		lck_mtx_unlock(&sweet_sbcont_mtx);
+		if (had) {
+			logged++;
+			printf("SWEET Sandbox: exit notify pid %d with a container entry (kept)\n", pid);
+		}
+	}
+}
+
+/* op 4: arg -> { pid (0 = self), 0, buf, len, 0 }; copies the path with its NUL */
+static int
+sweet_sbcont_path(struct proc *p, user_addr_t arg)
+{
+	struct {
+		uint64_t pid;
+		uint64_t unused1;
+		uint64_t buf;
+		uint64_t len;
+		uint64_t unused2;
+	} req;
+	char *path;
+	size_t plen = 0;
+	pid_t pid;
+	uint64_t uid;
+	int err = ENOENT;
+
+	if (!proc_is64bit(p) || arg == USER_ADDR_NULL) {
+		return EFAULT;
+	}
+	if (copyin(arg, &req, sizeof(req))) {
+		return EFAULT;
+	}
+	pid = (pid_t)req.pid;
+	if (pid == 0 || pid == proc_pid(p)) {
+		pid = proc_pid(p);
+		uid = proc_uniqueid(p);
+	} else {
+		proc_t t = proc_find(pid);
+		if (t == NULL) {
+			return ESRCH;
+		}
+		uid = proc_uniqueid(t);
+		proc_rele(t);
+	}
+	path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (path == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&sweet_sbcont_mtx);
+	uint64_t stored = 0;
+	for (unsigned int i = 0; i < SWEET_SBCONT_MAX; i++) {
+		/* pid only (v3): the uniqueid recorded at exec did not match the running image's (sb2: every
+		   lookup ENOENT); entries are cleared at exit and on the next exec of the pid */
+		if (sweet_sbcont[i].pid == pid && sweet_sbcont[i].path[0] != '\0') {
+			plen = strlcpy(path, sweet_sbcont[i].path, MAXPATHLEN) + 1;
+			stored = sweet_sbcont[i].uniqueid;
+			err = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&sweet_sbcont_mtx);
+	if (err == 0 && stored != uid && sweet_sbcont_uidlog < 16) {
+		sweet_sbcont_uidlog++;
+		printf("SWEET Sandbox: op4 pid %d uniqueid %llu, stored %llu\n", pid, uid, stored);
+	}
+	if (err == 0) {
+		if (plen > req.len) {
+			err = ERANGE;
+		} else if (copyout(path, (user_addr_t)req.buf, plen)) {
+			err = EFAULT;
+		}
+	}
+	static int late_logged;
+	uint64_t up_s = mach_absolute_time() / 24000000ULL;    /* 24 MHz timebase */
+	char cname[32];
+	proc_name(proc_pid(p), cname, sizeof(cname));
+	int wanted = err == 0 || strnstr(cname, "Provider", sizeof(cname)) || strnstr(cname, "sbcont", sizeof(cname));
+	if (sweet_sbcont_op4_logged < 16 || (up_s > 60 && wanted && late_logged++ < 48)) {     /* 0240 v2-v4 */
+		sweet_sbcont_op4_logged++;
+		char name[32];
+		proc_name(pid, name, sizeof(name));
+		printf("SWEET Sandbox: op4 by %s for pid %d (%s) -> %d [%.200s]\n", cname, pid, name, err,
+		    err == 0 ? path : "");
+	}
+	kfree_data(path, MAXPATHLEN);
+	return err;
+}
+
 static int
 sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
@@ -422,7 +768,8 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 		return sweet_sbext_enabled() ? sweet_sbext_issue(p, arg) : ENOENT;
 	case 6:         /* extension consume (0219) */
 		return sweet_sbext_enabled() ? sweet_sbext_consume(p, arg) : ENOENT;
-	case 4:         /* container path (audit token / pid) */
+	case 4:         /* container path (pid); 0240 */
+		return sweet_sbcont_enabled() ? sweet_sbcont_path(p, arg) : ENOENT;
 	case 0x43:      /* container expected */
 		return ENOENT;
 	default:
@@ -558,6 +905,8 @@ sweet_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
 static const struct mac_policy_ops sweet_sandbox_mac_ops = {
 	.mpo_policy_syscall = sweet_sandbox_syscall,
 	.mpo_priv_grant = sweet_sandbox_priv_grant,
+	.mpo_cred_check_label_update_execve = sweet_sandbox_check_execve,      /* 0240 */
+	.mpo_proc_notify_exit = sweet_sandbox_proc_notify_exit,                /* 0240 v4: logs only */
 };
 
 static struct mac_policy_conf sweet_sandbox_mac_conf = {
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..c3fce15 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -374,6 +374,7 @@ static int execargs_alloc(struct image_params *imgp);
 static int execargs_free(struct image_params *imgp);
 static int exec_check_permissions(struct image_params *imgp);
 static int exec_extract_strings(struct image_params *imgp);
+extern void sweet_sbcont_exec_env(proc_t p, const char *path, const char *env, const char *envend); /* 0240 v2 */
 static int exec_add_apple_strings(struct image_params *imgp, const load_result_t *load_result);
 static int exec_handle_sugid(struct image_params *imgp);
 static int sugid_scripts = 0;
@@ -1292,6 +1293,9 @@ grade:
 	AUDIT_ARG(envv, imgp->ip_endargv, imgp->ip_envc,
 	    imgp->ip_endenvv - imgp->ip_endargv);
 
+	/* 0240 v2: HOME container fallback for Sandbox op 4 (sweetsbcont=0 off) */
+	sweet_sbcont_exec_env(p, imgp->ip_strings + strlen(EXECUTABLE_KEY),
+	    imgp->ip_endargv, imgp->ip_endenvv);
 
 
 	/* reset local idea of thread, uthread, task */
