+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+/// ios-on-pixel 0105: pools made, pools destroyed by the cap, and spares held now (all devices).
+static POOLS_MADE: AtomicU64 = AtomicU64::new(0);
+static POOLS_CAPPED: AtomicU64 = AtomicU64::new(0);
+static POOLS_KEPT: AtomicUsize = AtomicUsize::new(0);
+
+/// ios-on-pixel 0105: the most spare command pools a device keeps, `SWEET_CMDPOOL_CAP` (read once,
+/// default 8; 0 = no cap). Each spare keeps its command buffers' Turnip streams, up to 1 MiB each.
+fn command_pool_cap() -> usize {
+    static CAP: OnceLock<usize> = OnceLock::new();
+    *CAP.get_or_init(|| {
+        std::env::var("SWEET_CMDPOOL_CAP")
+            .ok()
+            .and_then(|v| v.trim().parse().ok())
+            .unwrap_or(8)
+    })
+}
+
+/// ios-on-pixel 0105: a command pool was made (`command_buffer/mod.rs`).
+pub(super) fn note_command_pool_made() {
+    POOLS_MADE.fetch_add(1, Ordering::Relaxed);
+}
+
+/// ios-on-pixel 0105: `[made, kept now, destroyed by the cap]`, for the frontend's telemetry.
+pub fn sweet_command_pool_stats() -> [u64; 3] {
+    [
+        POOLS_MADE.load(Ordering::Relaxed),
+        POOLS_KEPT.load(Ordering::Relaxed) as u64,
+        POOLS_CAPPED.load(Ordering::Relaxed),
+    ]
+}
 
