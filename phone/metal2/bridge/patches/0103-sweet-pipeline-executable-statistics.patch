+//! sweet pipestats (`SWEET_PIPESTATS=1`, off by default): the driver's compiled-shader statistics
+//! (`VK_KHR_pipeline_executable_properties`) of every render `VkPipeline` the device makes, one
+//! `PIPESTAT` line per executable through the device's message sink (id name `sweet-pipestats`).
+
+use crate::Device;
+use ash::vk;
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+
+/// Whether `SWEET_PIPESTATS` asks for the statistics.
+pub(crate) fn requested() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var_os("SWEET_PIPESTATS").is_some_and(|value| !value.is_empty() && value != "0")
+    })
+}
+
+/// One line straight into `/var/local/mtl2.log` and `/dev/console`, as the frontend's `sm2_logs`
+/// does, so it never depends on the message sink. Only with `SWEET_PIPESTATS` set.
+pub(crate) fn note(text: &str) {
+    use std::io::Write;
+    use std::sync::Mutex;
+    if !requested() {
+        return;
+    }
+    static FILES: OnceLock<Vec<Mutex<std::fs::File>>> = OnceLock::new();
+    let files = FILES.get_or_init(|| {
+        ["/dev/console", "/var/local/mtl2.log"]
+            .iter()
+            .filter_map(|path| std::fs::OpenOptions::new().append(true).open(path).ok())
+            .map(Mutex::new)
+            .collect()
+    });
+    let line = format!(
+        "MTL2[{} {}]: {text}\n",
+        std::process::id(),
+        std::env::args().next().unwrap_or_default()
+    );
+    for file in files {
+        if let Ok(mut file) = file.lock() {
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
+
+/// Whether the device was made with `pipelineExecutableInfo`.
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn set_enabled() {
+    ENABLED.store(true, Ordering::Relaxed);
+}
+
+/// Whether pipelines are made to capture statistics and report them.
+pub(crate) fn active() -> bool {
+    requested() && ENABLED.load(Ordering::Relaxed)
+}
+
+thread_local! {
+    /// The state label and functions of the pipeline this thread is making (`creation_log.rs`).
+    static LABEL: RefCell<String> = const { RefCell::new(String::new()) };
+}
+
+/// Name the pipeline this thread makes next; empty when done.
+pub(crate) fn set_label(label: &str) {
+    LABEL.with(|current| {
+        let mut current = current.borrow_mut();
+        current.clear();
+        current.push_str(label);
+    });
+}
+
+/// Log the statistics of `pipeline`, one line per executable.
+pub(crate) fn report(device: &Device, pipeline: vk::Pipeline) {
+    let shared = device.shared();
+    static FIRST: AtomicBool = AtomicBool::new(true);
+    let first = FIRST.swap(false, Ordering::Relaxed);
+    let functions = ash::khr::pipeline_executable_properties::Device::new(
+        &shared.instance.raw,
+        shared.vk(),
+    );
+    let info = vk::PipelineInfoKHR::default().pipeline(pipeline);
+    // SAFETY: `pipeline` was just made on this device with the capture flag, and the device has
+    // the feature (`active`).
+    let executables = unsafe { functions.get_pipeline_executable_properties(&info) };
+    if first {
+        note(&format!(
+            "PIPESTAT first query: properties {:?}",
+            executables.as_ref().map(Vec::len)
+        ));
+    }
+    let Ok(executables) = executables else {
+        return;
+    };
+    let label = LABEL.with(|label| label.borrow().clone());
+    for (index, executable) in executables.iter().enumerate() {
+        let executable_info = vk::PipelineExecutableInfoKHR::default()
+            .pipeline(pipeline)
+            .executable_index(index as u32);
+        // SAFETY: as above, `index` from the driver's own list.
+        let statistics = unsafe { functions.get_pipeline_executable_statistics(&executable_info) };
+        if first && index == 0 {
+            note(&format!(
+                "PIPESTAT first query: statistics {:?}",
+                statistics.as_ref().map(Vec::len)
+            ));
+        }
+        let Ok(statistics) = statistics else {
+            continue;
+        };
+        let mut line = format!(
+            "PIPESTAT {label} {}",
+            executable
+                .name_as_c_str()
+                .unwrap_or_default()
+                .to_string_lossy()
+                .replace(' ', "_")
+        );
+        for statistic in &statistics {
+            let name = statistic
+                .name_as_c_str()
+                .unwrap_or_default()
+                .to_string_lossy()
+                .replace(' ', "_");
+            // SAFETY: the union member read is the one `format` names.
+            let value = unsafe {
+                match statistic.format {
+                    vk::PipelineExecutableStatisticFormatKHR::BOOL32 => {
+                        (statistic.value.b32 != 0).to_string()
+                    }
+                    vk::PipelineExecutableStatisticFormatKHR::INT64 => {
+                        statistic.value.i64.to_string()
+                    }
+                    vk::PipelineExecutableStatisticFormatKHR::UINT64 => {
+                        statistic.value.u64.to_string()
+                    }
+                    _ => statistic.value.f64.to_string(),
+                }
+            };
+            line.push_str(&format!(" {name}={value}"));
+        }
+        note(&line);
+    }
+}
