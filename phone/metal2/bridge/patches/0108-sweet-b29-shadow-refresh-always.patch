+/// 0108 (B29, diagnostic): `M2V_SHADOW_REFRESH=always`, read once, logged once into
+/// /dev/console and /var/local/mtl2.log as 0107's lines are.
+fn refresh_always() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("M2V_SHADOW_REFRESH").is_some_and(|v| v == "always");
+        if on {
+            use std::io::Write;
+            let line = format!(
+                "MTL2[{} {}]: B29 M2V_SHADOW_REFRESH=always: shadows copied in before every use\n",
+                std::process::id(),
+                std::env::args().next().unwrap_or_default()
+            );
+            for path in ["/dev/console", "/var/local/mtl2.log"] {
+                if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+                    let _ = file.write_all(line.as_bytes());
+                }
+            }
+        }
+        on
+    })
+}
