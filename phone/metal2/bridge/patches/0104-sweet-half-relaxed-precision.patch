+/// sweet half-relaxed: one line straight into `/dev/console` and `/var/local/mtl2.log` (as the
+/// frontend's `sm2_logs` does), when `METAL2VULKAN_HALF_RELAXED` or `SWEET_PIPESTATS` is set.
+pub fn half_relaxed_note(text: &str) {
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+    let set = |n: &str| std::env::var_os(n).is_some_and(|v| !v.is_empty() && v != "0");
+    if !(half_relaxed() || set("SWEET_PIPESTATS")) {
+        return;
+    }
+    static FILES: OnceLock<Vec<Mutex<std::fs::File>>> = OnceLock::new();
+    let files = FILES.get_or_init(|| {
+        ["/dev/console", "/var/local/mtl2.log"]
+            .iter()
+            .filter_map(|p| std::fs::OpenOptions::new().append(true).open(p).ok())
+            .map(Mutex::new)
+            .collect()
+    });
+    let line = format!(
+        "MTL2[{} {}]: {text}\n",
+        std::process::id(),
+        std::env::args().next().unwrap_or_default()
+    );
+    for f in files {
+        if let Ok(mut f) = f.lock() {
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
