+/// 0115 (B44): under `M2V_SHADOW_DUMP=all` (`input_dump_wanted`, which the caller asks first), the
+/// bytes of a copy into a texture up to 200x200, the first of each extent on each route, at most 40
+/// a process, to /var/local/b44/b44-WxH-ROW-OFF-FMT-PID-ROUTE.bin, with one "B44 dump" line as
+/// 0113's. Copied here, on the caller's thread; only the write is left to another.
+pub(super) fn input_dump(facts: InputDump, bytes: &[u8]) {
+    use std::io::Write;
+    static SEEN: Mutex<Vec<(u64, u64, &'static str)>> = Mutex::new(Vec::new());
+    let (width, height) = facts.texture;
+    if width > 200 || height > 200 {
+        return;
+    }
+    {
+        let key = (width, height, facts.route);
+        let mut seen = lock(&SEEN);
+        if seen.len() >= 40 || seen.contains(&key) {
+            return;
+        }
+        seen.push(key);
+    }
+    let bytes = bytes.to_vec();
+    let thread = std::thread::Builder::new().name("m2v-b44-dump".into());
+    let _ = exit_guard::spawn(thread, move || {
+        let pid = std::process::id();
+        let InputDump {
+            route,
+            format,
+            over_buffer,
+            bytes_per_row,
+            bytes_per_image,
+            offset,
+            origin,
+            size,
+            level,
+            ..
+        } = facts;
+        let name = format!(
+            "/var/local/b44/b44-{width}x{height}-{bytes_per_row}-{offset}-{format}-{pid}-{route}.bin"
+        );
+        let wrote = shadow_dump_write(&name, bytes.as_ptr(), bytes.len());
+        let line = format!(
+            "MTL2[{pid} {}]: B44 dump mtlfmt {format} route {route} {width}x{height} over-buffer {over_buffer} bytesPerRow {bytes_per_row} bytesPerImage {bytes_per_image} off {offset} origin {origin:?} size {size:?} level {level} bytes {} {name}: {wrote}\n",
+            std::env::args().next().unwrap_or_default(),
+            bytes.len()
+        );
+        for path in ["/dev/console", "/var/local/mtl2.log"] {
+            if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+                let _ = file.write_all(line.as_bytes());
+            }
+        }
+    });
+}
