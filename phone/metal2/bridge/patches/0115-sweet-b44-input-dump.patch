+/// 0115 (B44): `input_dump` of a copy from `buffer` laid out as `layout` into `region` of
+/// `texture`: the bytes it reads, up to the buffer's length, where the CPU reaches them. A row
+/// pitch or image pitch of 0 reads as `HostLayout::host_len` counts it.
+fn input_dump_of_blit(
+    buffer: &Buffer,
+    texture: &Texture,
+    layout: &BufferLayout,
+    region: &TextureRegion,
+    unit: &CopyUnit,
+) {
+    let Some(contents) = buffer.contents().filter(|_| !buffer.detached()) else {
+        return;
+    };
+    let s = shape(region.size, unit);
+    if s.row_bytes == 0 || s.rows == 0 || s.images == 0 {
+        return;
+    }
+    let reads = (s.images - 1)
+        .saturating_mul(layout.bytes_per_image)
+        .saturating_add((s.rows - 1).saturating_mul(layout.bytes_per_row))
+        .saturating_add(s.row_bytes);
+    let size = reads.min(buffer.length().saturating_sub(layout.offset)) as usize;
+    if size == 0 {
+        return;
+    }
+    // SAFETY: not detached, and offset + size lies inside the buffer's length.
+    let bytes = unsafe {
+        std::slice::from_raw_parts(contents.as_ptr().add(layout.offset as usize), size)
+    };
+    let facts = InputDump {
+        route: "blitbuf",
+        texture: (texture.width(), texture.height()),
+        format: texture.pixel_format() as usize,
+        over_buffer: texture.over_buffer(),
+        bytes_per_row: layout.bytes_per_row,
+        bytes_per_image: layout.bytes_per_image,
+        offset: layout.offset,
+        origin: region.origin,
+        size: region.size,
+        level: region.level,
+    };
+    input_dump(facts, bytes);
+}
