+/// 0109 (B29): `M2V_SHADOW_REPACK=1`, read once: shadow copies of rows not 64-byte multiples
+/// go through a staging buffer of 64-byte rows (`Texels::shadow_copies`).
+fn shadow_repack() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("M2V_SHADOW_REPACK").is_some_and(|v| v == "1"))
+}
+
+/// 0109 (B29): the first 8 repacked textures, into /dev/console and /var/local/mtl2.log as
+/// 0107's lines are.
+fn repack_log(width: u64, height: u64, texel_bytes: u64, pitch: u64, repacked: u64) {
+    use std::io::Write;
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static LOGGED: AtomicU32 = AtomicU32::new(0);
+    if LOGGED.fetch_add(1, Ordering::Relaxed) >= 8 {
+        return;
+    }
+    let line = format!(
+        "MTL2[{} {}]: B29 repack {width}x{height} fmt {texel_bytes}B row {pitch} -> {repacked}\n",
+        std::process::id(),
+        std::env::args().next().unwrap_or_default()
+    );
+    for path in ["/dev/console", "/var/local/mtl2.log"] {
+        if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
