diff --git a/src/freedreno/vulkan/tu_cs.cc b/src/freedreno/vulkan/tu_cs.cc
index 47e1939d611..82bb6cbff1a 100644
--- a/src/freedreno/vulkan/tu_cs.cc
+++ b/src/freedreno/vulkan/tu_cs.cc
@@ -34,6 +34,7 @@ tu_cs_init(struct tu_cs *cs,
    cs->device = device;
    cs->mode = mode;
    cs->next_bo_size = initial_size;
+   cs->sweet_initial_bo_size = initial_size;
    cs->name = name;
 }
 
@@ -496,6 +497,8 @@ tu_cs_reserve_space(struct tu_cs *cs, uint32_t reserved_size)
    return VK_SUCCESS;
 }
 
+uint64_t tu_sweet_cs_trims;
+
 /**
  * Reset a command stream to its initial state.  This discards all comand
  * packets in \a cs, but does not necessarily release all resources.
@@ -522,6 +525,34 @@ tu_cs_reset(struct tu_cs *cs)
 
    assert(!cs->writeable);
 
+   /* 0107: don't keep a big last BO forever in pooled command buffers.
+    * SWEET_CS_TRIM_KB (default 0 = off; e.g. 256): a kept BO above it is freed
+    * too and next_bo_size goes back to its initial value. */
+   static int64_t trim_kb = -1;
+   if (trim_kb < 0)
+      trim_kb = debug_get_num_option("SWEET_CS_TRIM_KB", 0);
+   bool trimmed = false;
+   if (trim_kb > 0) {
+      struct tu_bo_array *arrs[2] = { &cs->read_only, &cs->read_write };
+      for (unsigned a = 0; a < 2; a++) {
+         struct tu_bo_array *bos = arrs[a];
+         if (!bos->bo_count)
+            continue;
+         struct tu_bo *last = bos->bos[bos->bo_count - 1];
+         if (last->size <= (uint64_t)trim_kb * 1024)
+            continue;
+         TU_RMV(resource_destroy, cs->device, last);
+         tu_bo_finish(cs->device, last);
+         bos->bo_count = 0;
+         trimmed = true;
+         p_atomic_inc(&tu_sweet_cs_trims);
+      }
+   }
+   if (trimmed && cs->sweet_initial_bo_size)
+      cs->next_bo_size = cs->sweet_initial_bo_size;
+   if (trimmed && !cs->read_only.bo_count && !cs->refcount_bo)
+      cs->start = cs->cur = cs->reserved_end = cs->end = NULL;
+
    if (cs->read_only.bo_count) {
       cs->read_only.bos[0] = cs->read_only.bos[cs->read_only.bo_count - 1];
       cs->read_only.bo_count = 1;
