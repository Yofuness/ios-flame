+
    unsigned tile_render_pass_count;
    bool renderpass_cb_disabled;
 };
diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 527a4d4380d..f604d510fc8 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -3197,6 +3197,10 @@ tu_CreateDevice(VkPhysicalDevice physicalDevice,
    device->use_lrz = !TU_DEBUG_START(NOLRZ);
 
    tu_gpu_tracepoint_config_variable();
+   /* sweet 0105: TU_SWEET_DRAW_TRACE=1 records a GPU timestamp pair around every draw (MESA_GPU_TRACES=print).
+    * Off by default: no extra commands are emitted. */
+   if (debug_get_num_option("TU_SWEET_DRAW_TRACE", 0))
+      tu_gpu_tracepoint |= TU_GPU_TRACEPOINT_DRAW;
 
    device->submit_count = 0;
    list_inithead(&device->copy_timestamp_cs_pool);
diff --git a/src/freedreno/vulkan/tu_tracepoints.py b/src/freedreno/vulkan/tu_tracepoints.py
