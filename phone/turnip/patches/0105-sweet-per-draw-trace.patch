+                        Arg(type='uint8_t',  name='blend0',    var='cmd->vk.dynamic_graphics_state.cb.attachments[0].blend_enable', c_format='%u'),],
+             tp_default_enabled=False)
 
 begin_end_tp('binning_ib')
 begin_end_tp('concurrent_binning_ib')
