diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 60ad3a8ef90..541b9f8487f 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -8319,6 +8319,7 @@ tu6_draw_common(struct tu_cmd_buffer *cmd,
       cmd->state.program.stage_blake3[MESA_SHADER_TESS_EVAL],
       cmd->state.program.stage_blake3[MESA_SHADER_GEOMETRY],
       cmd->state.program.stage_blake3[MESA_SHADER_FRAGMENT]);
+   cmd->state.sweet_instance_count = 0; /* sweet 0105: consumed by the tracepoint above */
 
    /* Emit state first, because it's needed for bandwidth calculations */
    uint32_t dynamic_draw_state_dirty = 0;
@@ -8775,6 +8776,7 @@ tu_CmdDraw(VkCommandBuffer commandBuffer,
 
    tu6_emit_vs_params(cmd, 0, firstVertex, firstInstance);
 
+   cmd->state.sweet_instance_count = instanceCount; /* sweet 0105 */
    tu6_draw_common<CHIP>(cmd, cs, false, vertexCount);
 
    tu_cs_emit_pkt7(cs, CP_DRAW_INDX_OFFSET, 3);
@@ -8849,6 +8851,7 @@ tu_CmdDrawIndexed(VkCommandBuffer commandBuffer,
 
    tu6_emit_vs_params(cmd, 0, vertexOffset, firstInstance);
 
+   cmd->state.sweet_instance_count = instanceCount; /* sweet 0105 */
    tu6_draw_common<CHIP>(cmd, cs, true, indexCount);
 
    tu_cs_emit_pkt7(cs, CP_DRAW_INDX_OFFSET, 7);
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index 17bebebd135..ab3dbe8975d 100644
