+/* SweetMetal2 0106: SWEET_BOLEAK=1 logs the life of 1 MiB BOs and the retire ring (backboardd leaks 1 MiB kernel BOs). */
+static struct {
+   int on; /* -1 = env not read yet */
+   uint64_t alloc_1m, free_1m, retired_1m, live, next_ns, t0_ns;
+   uint32_t done; /* newest fence a reap sweep saw signalled */
+   unsigned alloc_logged, skip_logged;
+} sbl = { .on = -1 };
+
+static inline bool
+sbl_on(void)
+{
+   if (likely(sbl.on >= 0))
+      return sbl.on;
+   sbl.on = debug_get_bool_option("SWEET_BOLEAK", false);
+   sbl.t0_ns = os_time_get_nano();
+   return sbl.on;
+}
+
+static void
+sbl_skip(const char *reason, uint64_t size)
+{
+   if (sbl_on() && p_atomic_inc_return(&sbl.skip_logged) <= 32) {
+      mesa_logi("SWEETBOLEAK skip %s size %llu", reason, (unsigned long long)(size >> 10));
+      fflush(NULL);
+   }
+}
