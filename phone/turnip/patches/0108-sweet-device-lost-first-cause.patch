+/* SweetMetal2 0108: the first loss of this process, once, into /dev/console and /var/local/mtl2.log, with the
+ * backend's counters. No locks: the caller may hold any of them. Off: M2V_DEVLOST_LOG=0. */
+void (*vk_sweet_lost_stats)(struct vk_device *device, char *text, size_t size);
+
+void
+vk_sweet_lost_note(struct vk_device *device, const char *file, int line, const char *msg)
+{
+#if DETECT_OS_APPLE
+   static int said;
+   const char *off = getenv("M2V_DEVLOST_LOG");
+   if ((off && !strcmp(off, "0")) || p_atomic_cmpxchg(&said, 0, 1) != 0)
+      return;
+   char stats[256] = "";
+   if (vk_sweet_lost_stats)
+      vk_sweet_lost_stats(device, stats, sizeof(stats));
+   char text[700];
+   int n = snprintf(text, sizeof(text), "MTL2[%d %s]: DEVLOST first (turnip) VK_ERROR_DEVICE_LOST %s:%d: %s; %s\n",
+                    getpid(), getprogname(), file, line, msg, stats);
+   if (n > (int)sizeof(text) - 1)
+      n = sizeof(text) - 1;
+   const char *paths[] = { "/dev/console", "/var/local/mtl2.log" };
+   for (unsigned i = 0; i < 2; i++) {
+      int fd = open(paths[i], O_WRONLY | O_APPEND | O_NOCTTY);
+      if (fd >= 0) {
+         (void)!write(fd, text, n);
+         close(fd);
+      }
+   }
+#endif
 }
 
