#!/usr/bin/env python3
"""Screenshot of the phone's framebuffer (or any surface in physical memory) as a PNG.

  tools/flame-shot OUT.png [--pa PA] [--w W] [--h H] [--stride BYTES] [--fmt bgra|rgba] [--raw OUT.bin]

Default: the panel framebuffer ABL scans out (sunfish 0x9c000000, 1080x2340, 4352-byte rows once the GPU presents (2026-10-30;
4320 before), a8r8g8b8
= bytes B G R A). Reads /dev/pmem through the file server (kernel 0094+, FlameBridge 2223), so the
pixels are exact: compare them, don't eyeball them. Prints the time and the centre pixel.
"""
import argparse, importlib.util, os, struct, sys, time, zlib

here = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_file_location('flame_files', os.path.join(here, 'flame-files.py'))
ff = importlib.util.module_from_spec(spec)
spec.loader.exec_module(ff)


def png(path, w, h, rows):
    def chunk(t, d):
        c = struct.pack('>I', len(d)) + t + d
        return c + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    raw = b''.join(b'\0' + r for r in rows)
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b'IDAT', zlib.compress(raw, 6)))
        f.write(chunk(b'IEND', b''))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('out')
    ap.add_argument('--pa', type=lambda x: int(x, 0), default=0x9c000000)  # sunfish splash (flame 0x9c400000)
    ap.add_argument('--w', type=int, default=1080)
    ap.add_argument('--h', type=int, default=2340)
    ap.add_argument('--stride', type=int, default=4352)  # SWEET_FB_GPU_ROWBYTES once the GPU presents ("SWEET GPU: panel stride 4352"); 4320 before
    ap.add_argument('--fmt', choices=['bgra', 'rgba'], default='bgra')
    ap.add_argument('--raw', help='also save the raw bytes')
    a = ap.parse_args()
    stride = a.stride or a.w * 4
    t0 = time.time()
    data = ff.read_range(ff.conn(), '/dev/pmem', a.pa, stride * a.h)
    dt = time.time() - t0
    if a.raw:
        open(a.raw, 'wb').write(data)
    order = (2, 1, 0) if a.fmt == 'bgra' else (0, 1, 2)
    rows = []
    for y in range(a.h):
        r = data[y * stride:y * stride + a.w * 4]
        rgb = bytearray(a.w * 3)
        rgb[0::3] = r[order[0]::4]
        rgb[1::3] = r[order[1]::4]
        rgb[2::3] = r[order[2]::4]
        rows.append(bytes(rgb))
    png(a.out, a.w, a.h, rows)
    c = (a.h // 2) * stride + (a.w // 2) * 4
    print(f'{a.out}: {a.w}x{a.h} from {a.pa:#x}, {len(data) / 1e6:.1f} MB in {dt:.2f} s '
          f'({len(data) / 1e6 / max(dt, 1e-6):.1f} MB/s); centre pixel {data[c:c + 4].hex()}')


if __name__ == '__main__':
    main()
